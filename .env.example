# Site
SITE=https://www.bx33661.com
BASE_URL=/

# Feature toggles (CI verification forces analytics and comments to false;
# deploy.yml rebuilds dist/ on main pushes when either toggle is "true")
PUBLIC_ENABLE_ANALYTICS=false
PUBLIC_ENABLE_COMMENTS=false
PUBLIC_ENABLE_SEARCH=true

# Optional integrations
# Giscus comments
# Example:
# PUBLIC_GISCUS_REPO=bx33661/bx33661.github.io
# PUBLIC_GISCUS_REPO_ID=R_kgDOxxxxxx
# PUBLIC_GISCUS_CATEGORY=Announcements
# PUBLIC_GISCUS_CATEGORY_ID=DIC_kwDOxxxxxx4Cxxxx
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=
PUBLIC_GISCUS_CATEGORY_ID=

# Search engine notifications (CI secrets / variables)
# Optional IndexNow host override (defaults to https://www.bx33661.com)
# INDEXNOW_SITE=https://www.bx33661.com
# Baidu ordinary inclusion push API: https://ziyuan.baidu.com/linksubmit/index
BAIDU_PUSH_SITE=https://www.bx33661.com
BAIDU_PUSH_TOKEN=
