# Site origin and optional subpath (used by astro.config.ts and CI)
SITE=https://astro-orbit.example.com/
BASE_URL=/

# Feature toggles
PUBLIC_ENABLE_ANALYTICS=false
PUBLIC_ENABLE_COMMENTS=false
PUBLIC_ENABLE_SEARCH=true

# Optional privacy-friendly analytics (rendered only when PUBLIC_ENABLE_ANALYTICS=true)
# Umami (recommended):
# PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
# PUBLIC_UMAMI_WEBSITE_ID=your-website-id
PUBLIC_UMAMI_SCRIPT_URL=
PUBLIC_UMAMI_WEBSITE_ID=

# Plausible:
# PUBLIC_PLAUSIBLE_DOMAIN=your-domain.com
# PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_SCRIPT_URL=

# Google Analytics 4:
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
PUBLIC_GA_MEASUREMENT_ID=

# Optional Giscus comments (https://giscus.app)
# PUBLIC_GISCUS_REPO=your-username/your-repo
# PUBLIC_GISCUS_REPO_ID=R_kgDOxxxxxx
# PUBLIC_GISCUS_CATEGORY=Announcements
# PUBLIC_GISCUS_CATEGORY_ID=DIC_kwDOxxxxxx4Cxxxx
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=
PUBLIC_GISCUS_CATEGORY_ID=
