---
import { SITE } from "@/config.ts";
import { SOCIALS } from "@/constants";
import { DEFAULT_LOCALE, localizedPath } from "@/i18n";
import { ui } from "@/i18n/ui";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import GithubHeatmap from "@/components/GithubHeatmap.astro";
import IconRss from "@/assets/icons/IconRss.svg";
import { PROJECTS } from "@/data/projects";
import { withBase } from "@/utils/url";
import "@/styles/projects.css";

const isZh = DEFAULT_LOCALE === "zh-CN";
const copy = isZh ? SITE.projectsPage.zh : SITE.projectsPage.en;
const t = ui(DEFAULT_LOCALE);
const handle = SITE.profile.replace(/\/$/, "").split("/").pop() || SITE.defaultAuthorId;
---

<Layout title={`${copy.title} | ${SITE.title}`} description={copy.description}>
  <Header />

  <main id="main-content" class="projects-main app-layout">
    <header class="pj-intro">
      <img src={withBase(SITE.friendCard.avatar)} alt={SITE.author} class="pj-avatar" width="96" height="96" />
      <div>
        <p class="pj-prompt" aria-hidden="true">&gt; ls ~/projects<span class="pj-caret">_</span></p>
        <h1 class="pj-title">{SITE.author} <span>@{handle}</span></h1>
        <p class="pj-lead">{copy.leadEn}</p>
        <p class="pj-lead pj-lead-cn">{copy.leadSub}</p>
        <div class="pj-social">
          {
            SOCIALS.map((social) => (
              <a href={social.href} aria-label={social.name} title={social.linkTitle}>
                <social.icon class="fill-transparent stroke-current stroke-[1.75]" />
              </a>
            ))
          }
          <a href={localizedPath("/rss.xml", DEFAULT_LOCALE)} aria-label={t.rssFeed} title={t.rssFeed}>
            <IconRss class="fill-transparent stroke-current stroke-[1.75]" />
          </a>
        </div>
      </div>
    </header>

    {
      SITE.features.githubHeatmap && (
        <section class="pj-section" aria-labelledby="pj-activity">
          <h2 id="pj-activity" class="pj-eyebrow">{t.activityOnGithub}</h2>
          <GithubHeatmap profile={SITE.profile} />
        </section>
      )
    }

    <section id="project-list" class="pj-section" aria-labelledby="pj-projects">
      <div class="pj-section-head">
        <div>
          <h2 id="pj-projects" class="pj-eyebrow">{copy.title}</h2>
          <p class="pj-section-desc">{copy.description}</p>
        </div>
        <a class="pj-cta" href={SITE.profile}>{t.allRepositories} <span aria-hidden="true">→</span></a>
      </div>

      {
        PROJECTS.length > 0 ? (
          <div class="pj-grid">
            {PROJECTS.map((project) => (
              <article class="pj-card">
                <a class="pj-card-link" href={project.homepage ?? project.repo} aria-label={t.openProjectLabel(project.name)} />
                <div class="pj-card-top">
                  <div class="pj-card-name">
                    <img
                      class="pj-logo"
                      src={withBase(project.logo)}
                      alt=""
                      width="40"
                      height="40"
                      loading="lazy"
                      decoding="async"
                    />
                    <div class="pj-card-title">
                      <h3>{project.name}</h3>
                      <p class="pj-kind">{project.kind}</p>
                    </div>
                  </div>
                  <svg class="pj-arrow" viewBox="0 0 16 16" aria-hidden="true">
                    <path
                      d="M5 11 11 5M6 5h5v5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </div>
                <p class="pj-summary">{project.summary}</p>
                <p class="pj-desc">{project.description}</p>
                <ul class="pj-topics" aria-label={t.topics}>
                  {project.topics.map((topic) => (
                    <li>{topic}</li>
                  ))}
                </ul>
                <div class="pj-card-foot">
                  <div class="pj-cmd">
                    <code>
                      <span aria-hidden="true">$ </span>
                      {project.command}
                    </code>
                    <button
                      type="button"
                      class="pj-copy"
                      data-copy={project.command}
                      data-label-default={t.copyCmd}
                      data-label-copied={t.copiedCmd}
                      aria-label={t.copyCmdLabel(project.command)}
                    >
                      {t.copyCmd}
                    </button>
                  </div>
                  <div class="pj-meta">
                    <span class="pj-lang">
                      <i style={`background:${project.languageColor}`} aria-hidden="true" />
                      {project.language}
                    </span>
                    {project.license && <span>{project.license}</span>}
                    <span>
                      {t.updatedShort} <time datetime={project.updated}>{project.updated}</time>
                    </span>
                    <span class="pj-links">
                      <a href={project.repo}>{t.repoLink}</a>
                      {project.homepage && <a href={project.homepage}>{t.siteLink}</a>}
                    </span>
                  </div>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <p class="border-border-subtle bg-surface/75 text-muted-foreground rounded-xl border p-6 text-sm">
            {t.emptyProjects}
          </p>
        )
      }
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const bindCopyButtons = () => {
    document.querySelectorAll<HTMLButtonElement>(".pj-copy[data-copy]").forEach((button) => {
      if (button.dataset.bound) return;
      button.dataset.bound = "true";
      const defaultLabel = button.dataset.labelDefault || button.textContent?.trim() || "copy";
      const copiedLabel = button.dataset.labelCopied || "copied";
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? "");
          button.textContent = copiedLabel;
          button.dataset.copied = "true";
          window.setTimeout(() => {
            button.textContent = defaultLabel;
            delete button.dataset.copied;
          }, 1600);
        } catch {
          /* Clipboard unavailable in restricted contexts. */
        }
      });
    });
  };
  bindCopyButtons();
  document.addEventListener("astro:page-load", bindCopyButtons);
</script>
