---
import type { GetStaticPaths } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import EntryRow from "@/components/EntryRow.astro";
import Pagination from "@/components/Pagination.astro";
import { SITE } from "@/config.ts";
import { getAllNotesWithSlugs, type NoteWithSlug } from "@/utils/notes";

export const getStaticPaths = (async ({ paginate }) => {
  const notes = await getAllNotesWithSlugs();
  return paginate(notes, { pageSize: 10 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const noteEntries = page.data as NoteWithSlug[];
---

<Layout
  title={`全部笔记：学习与实践记录${page.currentPage > 1 ? ` · 第 ${page.currentPage} 页` : ""} | ${SITE.title}`}
  description="BX 的技术笔记归档，按时间整理网络安全、CTF、开发工具与学习实践记录。"
  canonicalURL={Astro.url.toString()}
  noindex={page.currentPage > 1}
>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-6">
    <header class="page-head">
      <p class="page-kicker">NOTES / ARCHIVE</p>
      <h1>全部笔记</h1>
      <p>按时间浏览学习与实践记录。</p>
    </header>
    <ul class="entry-list">
      {
        noteEntries.map(({ note, slug }) => (
          <EntryRow
            href={`/notes/${slug}/`}
            title={note.data.title}
            description={note.data.description}
            date={note.data.date}
            category={note.data.category || "未分类"}
          />
        ))
      }
    </ul>
  </main>
  <Pagination {page} />
  <Footer noMarginTop={page.lastPage > 1} />
</Layout>

<style>
  .page-head {
    margin: 0.4rem 0 1.8rem;
  }
  .page-kicker {
    margin: 0 0 0.45rem;
    color: var(--accent);
    font-family: var(--font-cartograph), ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.85rem, 3.5vw, 2.35rem);
    font-weight: 700;
    letter-spacing: -0.035em;
  }
  .page-head > p:last-child {
    margin: 0.55rem 0 0;
    color: color-mix(in srgb, var(--foreground) 68%, transparent);
    line-height: 1.7;
  }
  .entry-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
