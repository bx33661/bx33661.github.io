---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import EntryRow from "@/components/EntryRow.astro";
import { SITE } from "@/config.ts";
import { getAllNotesWithSlugs } from "@/utils/notes";

const notes = await getAllNotesWithSlugs();
const categories = new Map<string, number>();
const tags = new Map<string, number>();

for (const { note } of notes) {
  const category = note.data.category || "未分类";
  categories.set(category, (categories.get(category) || 0) + 1);
  for (const tag of note.data.tags || []) {
    tags.set(tag, (tags.get(tag) || 0) + 1);
  }
}

const categoryEntries = Array.from(categories.entries()).sort(
  (a, b) => b[1] - a[1],
);
---

<Layout
  title={`Notes | ${SITE.title}`}
  description="BX 的学习笔记索引，按分类整理编程语言、开发工具与安全技术的学习记录，提供最近更新和全部笔记入口。"
  canonicalURL={Astro.url.toString()}
>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-10">
    <header class="page-head">
      <p class="page-kicker">NOTES / INDEX</p>
      <h1>学习笔记</h1>
      <p class="page-description">持续记录学习过程、技术细节与实践中的问题。</p>
      <p class="page-meta">
        总笔记 {notes.length} 篇，分类 {categories.size} 个，标签 {tags.size} 个。
      </p>
    </header>

    <section class="content-section">
      <h2>分类</h2>
      {
        categoryEntries.length === 0 ? (
          <p class="mt-2 text-foreground/70">暂无分类。</p>
        ) : (
          <ul class="mt-3 flex flex-wrap gap-2">
            {categoryEntries.map(([category, count]) => (
              <li class="rounded-full border border-border/30 px-3 py-1 text-sm">
                {category} ({count})
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section class="content-section">
      <div class="section-head">
        <h2>最近更新</h2>
        <a href="/notes/list/">全部笔记 →</a>
      </div>
      <ul class="entry-list">
        {
          notes
            .slice(0, 10)
            .map(({ note, slug }) => (
              <EntryRow
                href={`/notes/${slug}/`}
                title={note.data.title}
                description={note.data.description}
                date={note.data.date}
                category={note.data.category || "未分类"}
                heading="h3"
              />
            ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-head {
    padding: 0.4rem 0 1.6rem;
  }
  .page-kicker {
    margin: 0 0 0.45rem;
    color: var(--accent);
    font-family: var(--font-cartograph), ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.85rem, 3.5vw, 2.35rem);
    font-weight: 700;
    letter-spacing: -0.035em;
  }
  .page-description {
    margin: 0.55rem 0 0;
    color: color-mix(in srgb, var(--foreground) 68%, transparent);
    line-height: 1.7;
  }
  .page-meta {
    margin: 0.7rem 0 0;
    color: color-mix(in srgb, var(--foreground) 48%, transparent);
    font-size: 0.78rem;
  }
  .content-section {
    margin-top: 1.65rem;
    padding-top: 1.65rem;
    border-top: 1px solid color-mix(in srgb, var(--border) 28%, transparent);
  }
  .content-section h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }
  .section-head a {
    color: var(--accent);
    font-size: 0.78rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .section-head a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .entry-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  :global(html[data-theme="dark"]) .page-meta {
    color: color-mix(in srgb, var(--foreground) 68%, transparent);
  }
</style>
