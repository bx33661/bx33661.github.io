---
import "@pagefind/default-ui/css/ui.css";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { SITE } from "@/config.ts";
---

<Layout title={`搜索 | ${SITE.title}`} noindex>
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout search-main">
    <header class="search-head">
      <p class="search-kicker">SEARCH / INDEX</p>
      <h1>搜索</h1>
      <p>从文章、标签和技术记录中，找到你需要的内容。</p>
    </header>

    <section class="search-surface" aria-label="站内搜索">
      <div class="search-surface-head">
        <span>站内检索</span>
        <span class="search-keyboard"><kbd>⌘</kbd><kbd>K</kbd> 快速打开</span>
      </div>
      <div id="pagefind-search" class="search-results"></div>
      <div class="search-surface-foot">
        <span>支持标题、标签与正文关键词</span>
        <a href="/blog/">浏览全部文章 <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script src="../scripts/search-page.ts"></script>

<style>
  .search-main {
    padding-bottom: 5rem;
  }
  .search-head {
    margin: 0.4rem 0 1.75rem;
  }
  .search-kicker {
    margin: 0 0 0.45rem;
    color: var(--accent);
    font-family: var(--font-cartograph), ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .search-head h1 {
    margin: 0;
    color: var(--foreground);
    font-size: clamp(1.85rem, 3.5vw, 2.35rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .search-head > p:last-child {
    margin: 0.55rem 0 0;
    color: color-mix(in srgb, var(--foreground) 62%, transparent);
    font-size: 0.98rem;
    line-height: 1.6;
  }
  .search-surface {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--background);
  }
  .search-surface-head,
  .search-surface-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 0.85rem 1.15rem;
    color: color-mix(in srgb, var(--foreground) 55%, transparent);
    font-size: 0.78rem;
  }
  .search-surface-head {
    border-bottom: 1px solid var(--border);
    font-weight: 600;
  }
  .search-surface-foot {
    border-top: 1px solid var(--border);
  }
  .search-surface-foot a {
    color: var(--accent);
    text-decoration: none;
  }
  .search-surface-foot a:hover {
    text-decoration: underline;
  }
  .search-keyboard {
    display: inline-flex;
    align-items: center;
    gap: 0.22rem;
    font-weight: 400;
  }
  .search-keyboard kbd {
    min-width: 1.2rem;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    text-align: center;
    font-family: inherit;
    font-size: 0.72rem;
  }
  .search-results {
    min-height: 13rem;
    padding: 1rem 1.15rem 1.5rem;
  }
  #pagefind-search {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: var(--background);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-border-radius: 0.65rem;
  }
  #pagefind-search :global(.pagefind-ui__search-input),
  #pagefind-search :global(.search-fallback-input) {
    width: 100%;
    min-height: 3rem;
    border: 1px solid var(--border);
    border-radius: 0.65rem;
    background: var(--background);
    color: var(--foreground);
    font: inherit;
    padding: 0.7rem 0.9rem;
  }
  #pagefind-search :global(.pagefind-ui__search-input:focus-visible),
  #pagefind-search :global(.search-fallback-input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  #pagefind-search :global(.pagefind-ui__result),
  #pagefind-search :global(.search-fallback-results li) {
    padding: 1rem 0;
    border-top: 1px solid var(--border);
  }
  #pagefind-search :global(.pagefind-ui__result-title a),
  #pagefind-search :global(.search-fallback-link strong) {
    color: var(--foreground);
    font-size: 1rem;
    font-weight: 650;
    text-decoration: none;
  }
  #pagefind-search :global(.pagefind-ui__result-title a:hover),
  #pagefind-search :global(.search-fallback-link:hover strong) {
    color: var(--accent);
  }
  #pagefind-search :global(.pagefind-ui__result-excerpt),
  #pagefind-search :global(.search-fallback-link span) {
    display: block;
    margin-top: 0.4rem;
    color: color-mix(in srgb, var(--foreground) 65%, transparent);
    font-size: 0.88rem;
    line-height: 1.6;
  }
  #pagefind-search :global(.search-fallback-status) {
    margin: 1rem 0 0;
    color: color-mix(in srgb, var(--foreground) 60%, transparent);
    font-size: 0.85rem;
  }
  #pagefind-search :global(.search-fallback-results) {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
  }
  #pagefind-search :global(.search-fallback-link) {
    display: block;
    text-decoration: none;
  }
  #pagefind-search :global(mark) {
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    color: inherit;
  }
  #pagefind-search :global(.pagefind-ui__result-nested) {
    margin-top: 0.45rem;
    padding-left: 0.9rem;
    border-left: 1px solid var(--border);
  }
  @media (max-width: 640px) {
    .search-surface-head,
    .search-surface-foot,
    .search-results {
      padding-inline: 0.9rem;
    }
    .search-keyboard {
      display: none;
    }
  }
</style>
