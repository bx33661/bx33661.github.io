---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<Layout title="离线模式" description="您当前处于离线状态，请检查网络连接。" noindex={true}>
  <Header />

  <main id="main-content" class="app-layout flex flex-1 items-center justify-center py-14">
    <section
      class="border-border-subtle bg-surface/85 w-full max-w-lg rounded-2xl border p-8 text-center shadow-sm sm:p-10"
      aria-labelledby="offline-title"
    >
      <p class="font-cartograph text-accent mb-2 text-xs font-semibold tracking-widest uppercase">
        CONNECTION / OFFLINE
      </p>
      <h1 id="offline-title" class="text-foreground text-3xl font-bold tracking-tight">离线模式</h1>
      <p class="text-muted-foreground mt-3 text-sm leading-relaxed">当前网络未连接，你仍可以浏览本地已缓存的文章。</p>

      <div
        class="border-border-subtle bg-surface-subtle text-muted-foreground mt-5 inline-flex items-center gap-2 rounded-full border px-3.5 py-1.5 text-xs"
      >
        <span class="bg-accent size-2 rounded-full" aria-hidden="true"></span>
        <span id="network-status">检测网络状态中...</span>
      </div>

      <div class="mt-7 flex flex-wrap items-center justify-center gap-2.5">
        <button
          type="button"
          id="offline-retry"
          class="bg-accent text-background hover:bg-accent/90 rounded-lg px-4 py-2 text-sm font-semibold shadow-xs transition-all duration-150 hover:-translate-y-0.5"
        >
          重新连接
        </button>
        <a
          href="/"
          class="border-border-subtle bg-surface-subtle hover:border-accent/40 hover:text-accent rounded-lg border px-4 py-2 text-sm font-medium transition-colors duration-150"
        >
          返回首页
        </a>
        <a
          href="/blog/"
          class="border-border-subtle bg-surface-subtle hover:border-accent/40 hover:text-accent rounded-lg border px-4 py-2 text-sm font-medium transition-colors duration-150"
        >
          浏览博客
        </a>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    import { onAstroPage } from "@/scripts/astro-lifecycle";

    onAstroPage((signal) => {
      const statusEl = document.getElementById("network-status");
      const retryBtn = document.getElementById("offline-retry");
      if (!statusEl) return;

      const updateNetworkStatus = () => {
        statusEl.textContent = navigator.onLine ? "网络已连接，可点击“重新连接”刷新页面" : "网络未连接";
      };

      retryBtn?.addEventListener("click", () => location.reload(), { signal });
      window.addEventListener("online", updateNetworkStatus, { signal });
      window.addEventListener("offline", updateNetworkStatus, { signal });
      updateNetworkStatus();
    });
  </script>
</Layout>
