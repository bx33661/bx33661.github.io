---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import AcademicHome from "@/components/AcademicHome.astro";

const description =
  "Hey, I'm bx. A personal blog about Cybersecurity, Large Language Models (LLMs), and the things I learn, explore, and think about.";
---

<Layout
  title="bx · Cybersecurity, LLMs & Personal Notes"
  description={description}
  canonicalURL={Astro.url.toString()}
>
  <Header />
  <AcademicHome />
  <Footer />
</Layout>
