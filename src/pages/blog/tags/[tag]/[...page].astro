---
import type { GetStaticPathsOptions } from "astro";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import EntryRow from "@/components/EntryRow.astro";
import Pagination from "@/components/Pagination.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { getPath } from "@/utils/getPath";
import { resolveLegacyPostSlug } from "@/utils/legacySlug";
import { getTagPath } from "@/utils/tagPath";
import { SITE } from "@/config.ts";
import { getAllPosts } from "@/lib/data-utils";
export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getAllPosts();
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(posts, tag);

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: SITE.postPerPage,
    });
  });
}

const params = Astro.params;
const { tag } = params;
const { page, tagName } = Astro.props;

// Tags are on-site filters only — never seek search indexing.
const noindex = true;
---

<Layout title={`主题：${tagName} | ${SITE.title}`} noindex={noindex}>
  <Header />
  <Main
    pageTitle={["主题：", tagName]}
    titleTransition={tag}
    pageDesc={`与「${tagName}」相关的文章。`}
  >
    <ul class="entry-list">
      {
        page.data.map((post) => (
          <EntryRow
            href={getPath(
              post.id,
              post.filePath,
              true,
              resolveLegacyPostSlug(post),
            )}
            title={post.data.title}
            description={post.data.description}
            date={post.data.pubDatetime}
            updatedDate={post.data.modDatetime}
            variant="blog"
            tags={post.data.tags
              .filter((item) => !["bx", "others"].includes(item.toLowerCase()))
              .slice(0, 3)
              .map((item) => ({ label: item, href: getTagPath(item) }))}
          />
        ))
      }
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>

<style>
  .entry-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
