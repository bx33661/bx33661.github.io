---
import type { GetStaticPaths } from "astro";
import { readingTransition } from "@/utils/reading-motion";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import EntryRow from "@/components/EntryRow.astro";
import Pagination from "@/components/Pagination.astro";
import { groupPostsByTag } from "@/utils/getUniqueTags";
import { getPath } from "@/utils/getPath";
import { resolveLegacyPostSlug } from "@/utils/legacySlug";
import { getTagPath, getVisiblePostTags } from "@/utils/tagPath";
import { SITE } from "@/config.ts";
import { getAllPosts } from "@/lib/data-utils";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getAllPosts();
  return groupPostsByTag(posts).flatMap(({ tag, tagName, posts: tagPosts }) =>
    paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: SITE.postPerPage,
    }),
  );
}) satisfies GetStaticPaths;

const { tag } = Astro.params;
const { page, tagName } = Astro.props;
---

<Layout title={`主题：${tagName} | ${SITE.title}`} noindex>
  <Header />
  <Main pageTitle={["主题：", tagName]} titleTransition={tag} pageDesc={`与「${tagName}」相关的文章。`}>
    <ul class="entry-list" transition:name="reading-surface" transition:animate={readingTransition}>
      {
        page.data.map((post) => (
          <EntryRow
            href={getPath(post.id, post.filePath, true, resolveLegacyPostSlug(post))}
            title={post.data.title}
            description={post.data.description}
            date={post.data.pubDatetime}
            updatedDate={post.data.modDatetime}
            variant="blog"
            tags={getVisiblePostTags(post.data.tags).map((item) => ({ label: item, href: getTagPath(item) }))}
          />
        ))
      }
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
