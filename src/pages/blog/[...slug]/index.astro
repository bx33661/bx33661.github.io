---
import type { CollectionEntry } from "astro:content";
import RedirectPage from "@/components/RedirectPage.astro";
import PostDetails from "@/layouts/PostDetails.astro";
import { DEFAULT_LOCALE } from "@/i18n";
import { getAllPosts, getAllPostSlugs } from "@/lib/data-utils";
import { getAllNotesWithSlugs } from "@/utils/notes";
import { withBase } from "@/utils/url";

interface Props {
  post?: CollectionEntry<"blog">;
  redirectTo?: string;
}

export async function getStaticPaths() {
  const [postSlugs, notes] = await Promise.all([getAllPostSlugs(DEFAULT_LOCALE), getAllNotesWithSlugs(DEFAULT_LOCALE)]);
  const posts = postSlugs.map(({ slug, post }) => ({
    params: { slug },
    props: { post },
  }));
  const oldSlugs = new Set(postSlugs.map(({ slug }) => slug));
  const redirects = notes
    .filter(({ note }) => note.data.formerBlogSlug)
    .map(({ note, slug }) => ({
      params: { slug: note.data.formerBlogSlug! },
      props: { redirectTo: withBase(`/notes/${slug}/`) },
    }));
  for (const redirect of redirects) {
    if (oldSlugs.has(redirect.params.slug)) {
      throw new Error(`Moved note conflicts with active blog URL: ${redirect.params.slug}`);
    }
    oldSlugs.add(redirect.params.slug);
  }
  return [...posts, ...redirects];
}

const { post, redirectTo } = Astro.props;
const sortedPosts = redirectTo ? [] : await getAllPosts(DEFAULT_LOCALE);
---

{
  redirectTo ? (
    <RedirectPage
      target={redirectTo}
      title={DEFAULT_LOCALE === "zh-CN" ? "正在前往笔记" : "Redirecting to note"}
      lang={DEFAULT_LOCALE}
    />
  ) : (
    post && <PostDetails {post} posts={sortedPosts} />
  )
}
