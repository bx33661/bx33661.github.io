---
import RedirectPage from "@/components/RedirectPage.astro";
import { getPublishedGalleries } from "@/data/gallery";

export async function getStaticPaths() {
  const galleries = await getPublishedGalleries();
  return galleries.map(({ slug }) => ({ params: { gallery: slug } }));
}

const slug = Astro.params.gallery ?? "";
---

<RedirectPage target={`/galleries/${encodeURIComponent(slug)}/`} title="正在前往图集" />
