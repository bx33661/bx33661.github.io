---
import ArchiveIndex from "@/components/ArchiveIndex.astro";
import { SITE } from "@/config.ts";
import { BILINGUAL_ENABLED, SECONDARY_PREFIX } from "@/i18n";

export function getStaticPaths() {
  return BILINGUAL_ENABLED && SITE.features.archives ? [{ params: { locale: SECONDARY_PREFIX } }] : [];
}
