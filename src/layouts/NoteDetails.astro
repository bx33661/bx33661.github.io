---
import { render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import "katex/dist/katex.min.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { SITE } from "@/config.ts";
import { getAdjacentNotes } from "@/utils/notes";

import type { CollectionEntry } from "astro:content";
import { localeFromPath, localizedPath } from "@/i18n";
import { ui } from "@/i18n/ui";
interface Props { note: CollectionEntry<"notes">; slug: string; }
const { note, slug } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const t = ui(locale);
const { Content } = await render(note);
const { prev, next } = await getAdjacentNotes(slug, locale);
---

<Layout
  title={`${note.data.title} | ${SITE.title}`}
  description={note.data.description}
  pubDatetime={note.data.date}
  canonicalURL={Astro.url.toString()}
>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-10" data-pagefind-body>
    <article class="app-prose w-full max-w-app">
      <h1 class="text-3xl font-bold tracking-tight" data-pagefind-meta="title">{note.data.title}</h1>
      <p class="mt-4 leading-relaxed text-foreground/70" data-note-summary>{note.data.description}</p>
      <p class="mt-2 text-sm text-foreground/60">{note.data.date.toLocaleDateString(locale)}</p>
      {
        note.data.tags &&
        note.data.tags.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-2">
            {note.data.tags.map((tag: string) => (
              <span class="rounded-full border border-border/30 px-2 py-0.5 text-xs">#{tag}</span>
            ))}
          </div>
        )
      }
      <div class="mt-8">
        <Content />
      </div>
    </article>

    <div class="mt-10 grid gap-3 sm:grid-cols-2">
      {prev ? (
        <a class="rounded-xl border border-border/25 bg-muted/5 p-4" href={localizedPath(`/notes/${prev.slug}/`, locale)}>
          <p class="text-xs text-foreground/55">{t.previous}</p>
          <p class="mt-1 font-medium">{prev.note.data.title}</p>
        </a>
      ) : (
        <div></div>
      )}
      {next ? (
        <a class="rounded-xl border border-border/25 bg-muted/5 p-4 text-right" href={localizedPath(`/notes/${next.slug}/`, locale)}>
          <p class="text-xs text-foreground/55">{t.next}</p>
          <p class="mt-1 font-medium">{next.note.data.title}</p>
        </a>
      ) : (
        <div></div>
      )}
    </div>
  </main>
  <Footer />
</Layout>
