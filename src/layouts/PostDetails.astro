---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import "katex/dist/katex.min.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import EditPost from "@/components/EditPost.astro";
import PostToc from "@/components/PostToc.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import GalleryEmbed from "@/components/GalleryEmbed.astro";
import GiscusComments from "@/components/GiscusComments.astro";
import { getPath } from "@/utils/getPath";
import {
  createDeterministicSlug,
  resolveLegacyPostSlug,
} from "@/utils/legacySlug";
import { slugifyStr } from "@/utils/slugify";
import { getTagPath } from "@/utils/tagPath";
import { SITE } from "@/config.ts";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;
const postSlug = resolveLegacyPostSlug(post);

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
  hideEditPost,
} = post.data;

const { Content, headings } = await render(post);
const tocHeadings = headings.filter((heading) => heading.depth <= 3);
const displayDate =
  modDatetime && modDatetime > pubDatetime ? modDatetime : pubDatetime;
const dateLabel = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
}).format(displayDate);

let ogImageUrl: string | undefined;

// Determine OG image source
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage; // Remote OG image (absolute URL)
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src; // Local asset
}

// Use dynamic OG image if enabled and no remote|local ogImage
if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${getPath(post.id, post.filePath, true, postSlug)}index.png`;
}

// Resolve OG image URL (or fallback to SITE.ogImage / default `og.png`)
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  scrollSmooth: true,
  referrerPolicy: "no-referrer",
};

/* ========== Prev/Next Posts ========== */

const allPosts = posts.map(({ data: { title, slug }, id, filePath }) => ({
  id,
  title,
  filePath,
  slug: slug || createDeterministicSlug(id, "post"),
}));

const currentPostIndex = allPosts.findIndex((a) => a.id === post.id);

const prevPost = currentPostIndex > 0 ? allPosts[currentPostIndex - 1] : null;
const nextPost =
  currentPostIndex >= 0 && currentPostIndex < allPosts.length - 1
    ? allPosts[currentPostIndex + 1]
    : null;
---

<Layout {...layoutProps}>
  <Header />
  <BackButton currentTitle={title} />
  <main
    id="main-content"
    class:list={["relative app-layout pb-12", { "mt-8": !SITE.showBackButton }]}
    data-pagefind-body
  >
    <!-- Post header section -->
    <header class="post-header">
      <h1
        transition:name={slugifyStr(title.replaceAll(".", "-"))}
        class="post-title"
      >
        {title}
      </h1>
      <p class="post-description">{description}</p>
      <div class="post-meta">
        <span>{author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={displayDate.toISOString()}>{dateLabel}</time>
        {modDatetime && modDatetime > pubDatetime && <span>更新</span>}
      </div>
      <div class="post-header-tags">
        {
          tags.slice(0, 3).map((tag: string) => (
            <a href={getTagPath(tag)} class="post-tag-badge">
              <span aria-hidden="true">#</span>
              {tag}
            </a>
          ))
        }
        {
          tags.length > 3 && (
            <span class="post-tag-more">等 {tags.length} 个标签</span>
          )
        }
      </div>
    </header>

    <div class="post-reading">
      <div class="post-reading-content">
        <PostToc headings={tocHeadings} variant="inline" />
        <article
          id="article"
          class="app-prose w-full max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
        >
          <Content components={{ GalleryEmbed }} />
        </article>
      </div>
      <PostToc headings={tocHeadings} variant="sidebar" />
    </div>

    <!-- ═══════ Post footer section ═══════ -->
    <div class="mt-10 flex items-center gap-3" aria-hidden="true">
      <div
        class="h-px flex-1 bg-linear-to-r from-accent/20 via-border/30 to-transparent"
      >
      </div>
      <span
        class="font-cartograph text-[10px] tracking-widest text-accent/25 uppercase select-none"
        >// 结束</span
      >
      <div
        class="h-px flex-1 bg-linear-to-r from-transparent via-border/30 to-accent/20"
      >
      </div>
    </div>

    <EditPost class="mt-4" {hideEditPost} {post} />

    <!-- Tags & Share row -->
    <div
      class="mt-6 mb-8 flex flex-col items-center gap-6 sm:flex-row sm:items-start sm:justify-between"
    >
      <!-- Tags -->
      <div class="flex flex-wrap justify-center gap-2 sm:justify-start">
        {
          tags.map((tag: string) => (
            <a
              href={getTagPath(tag)}
              class="inline-flex items-center gap-1 rounded-full border border-border/25 bg-muted/10 px-2.5 py-1 font-cartograph text-xs transition-all duration-200 hover:border-accent/40 hover:bg-accent/5 hover:text-accent"
            >
              <span class="opacity-40">#</span>
              {tag}
            </a>
          ))
        }
      </div>

      <!-- Share links -->
      <ShareLinks />
    </div>

    <GiscusComments />

    <!-- Decorative separator before prev/next -->
    <div class="my-6 flex items-center gap-3" aria-hidden="true">
      <div
        class="h-px flex-1 bg-linear-to-r from-transparent via-border/30 to-transparent"
      >
      </div>
    </div>

    <!-- Previous/Next Post Navigation -->
    <div data-pagefind-ignore class="grid grid-cols-2 gap-3">
      {
        prevPost ? (
          <a
            href={getPath(prevPost.id, prevPost.filePath, true, prevPost.slug)}
            class="post-nav-link group relative flex flex-col gap-1 rounded-2xl border border-border/20 px-5 py-4 transition-all duration-300 hover:border-accent/30 hover:shadow-lg hover:shadow-accent/5"
          >
            <div class="post-nav-bg" />
            <div class="flex items-center gap-1.5">
              <svg
                class="size-3.5 text-accent/50 transition-transform duration-300 group-hover:-translate-x-1 rtl:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="19" y1="12" x2="5" y2="12" />
                <polyline points="12 19 5 12 12 5" />
              </svg>
              <span class="font-cartograph text-[10px] tracking-wider text-foreground/35 uppercase">
                上一篇
              </span>
            </div>
            <span class="line-clamp-2 text-sm leading-snug font-medium text-foreground/70 transition-colors duration-200 group-hover:text-accent">
              {prevPost.title}
            </span>
          </a>
        ) : (
          <div />
        )
      }
      {
        nextPost && (
          <a
            href={getPath(nextPost.id, nextPost.filePath, true, nextPost.slug)}
            class="post-nav-link group relative col-start-2 flex flex-col items-end gap-1 rounded-2xl border border-border/20 px-5 py-4 text-end transition-all duration-300 hover:border-accent/30 hover:shadow-lg hover:shadow-accent/5"
          >
            <div class="post-nav-bg" />
            <div class="flex items-center gap-1.5">
              <span class="font-cartograph text-[10px] tracking-wider text-foreground/35 uppercase">
                下一篇
              </span>
              <svg
                class="size-3.5 text-accent/50 transition-transform duration-300 group-hover:translate-x-1 rtl:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </div>
            <span class="line-clamp-2 text-sm leading-snug font-medium text-foreground/70 transition-colors duration-200 group-hover:text-accent">
              {nextPost.title}
            </span>
          </a>
        )
      }
    </div>
  </main>
  <BackToTopButton />
  <Footer />
</Layout>

<script src="../scripts/post-enhancements.ts"></script>

<style>
  .post-header {
    margin: 1.1rem 0 2rem;
    padding-bottom: 1.6rem;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 30%, transparent);
  }
  .post-title {
    max-width: 46rem;
    margin: 0;
    color: var(--foreground);
    font-size: clamp(1.9rem, 3.6vw, 2.55rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.25;
  }
  .post-description {
    max-width: 42rem;
    margin: 0.9rem 0 0;
    color: color-mix(in srgb, var(--foreground) 68%, transparent);
    font-size: 0.98rem;
    line-height: 1.75;
  }
  .post-meta,
  .post-header-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .post-meta {
    margin-top: 0.85rem;
    color: color-mix(in srgb, var(--foreground) 48%, transparent);
    font-size: 0.78rem;
  }
  .post-header-tags {
    margin-top: 1rem;
  }
  .post-tag-badge {
    padding: 0.28rem 0.55rem;
    border: 1px solid color-mix(in srgb, var(--border) 30%, transparent);
    border-radius: 999px;
    color: var(--accent);
    font-size: 0.73rem;
    text-decoration: none;
  }
  .post-tag-badge:hover {
    border-color: var(--accent);
  }
  .post-tag-more {
    color: color-mix(in srgb, var(--foreground) 48%, transparent);
    font-size: 0.73rem;
  }
  .post-reading-content {
    min-width: 0;
  }
  @media (min-width: 1500px) {
    .post-reading {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 12rem;
      gap: 2rem;
      width: calc(100% + 14rem);
    }
  }

  .post-nav-link {
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    background: color-mix(in srgb, var(--muted) 5%, transparent);
    position: relative;
  }

  .post-nav-link:hover {
    background: color-mix(in srgb, var(--accent) 4%, transparent);
  }

  /* Aurora glow layer — always visible, intensifies on hover */
  .post-nav-bg {
    position: absolute;
    inset: -1px;
    opacity: 0.5;
    transition: opacity 0.4s ease;
    background:
      radial-gradient(
        ellipse 80% 60% at 20% 80%,
        color-mix(in oklab, var(--accent) 12%, transparent) 0%,
        transparent 70%
      ),
      radial-gradient(
        ellipse 60% 70% at 80% 20%,
        color-mix(in oklab, var(--accent) 8%, transparent) 0%,
        transparent 60%
      ),
      radial-gradient(
        ellipse 90% 40% at 50% 100%,
        color-mix(in oklab, var(--accent) 6%, transparent) 0%,
        transparent 50%
      );
    filter: blur(16px);
    pointer-events: none;
    z-index: -1;
    border-radius: inherit;
  }

  .post-nav-link:hover .post-nav-bg {
    opacity: 1;
    filter: blur(20px);
  }
</style>
