---
import { BILINGUAL_ENABLED, localeFromPath, localizedPath, switchDestination } from "@/i18n";
import { languagePaths } from "@/i18n/content";
import { ui } from "@/i18n/ui";
const locale = localeFromPath(Astro.url.pathname);
const t = ui(locale);
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import "katex/dist/katex.min.css";
import "@/styles/post-reading.css";
import "@/styles/markdown-reading.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import EditPost from "@/components/EditPost.astro";
import PostToc from "@/components/PostToc.astro";
import PostDiscovery from "@/components/PostDiscovery.astro";
import ArticleLightbox from "@/components/ArticleLightbox.astro";
import { getArticleDates } from "@/utils/article-discovery";
import { formatSiteDate } from "@/utils/date";
import { cleanArticleMarkdownForCopy, countReadingWords, estimateReadingMinutes } from "@/utils/readingTime";
import { resolvePostOgImagePath } from "@/utils/generateOgImages";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import GiscusComments from "@/components/GiscusComments.astro";
import { getPath } from "@/utils/getPath";
import { resolveLegacyPostSlug } from "@/utils/legacySlug";
import { articleTransitionName, readingTransition } from "@/utils/reading-motion";
import { getLocalizedTagPath } from "@/utils/tagPath";
import { SITE } from "@/config.ts";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;
const postSlug = resolveLegacyPostSlug(post);
const postPath = (id: string, filePath: string | undefined, slug: string) =>
  localizedPath(getPath(id, filePath, true, slug), locale);

const {
  title,
  author,
  description,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
  hideEditPost,
  evergreen,
  links,
} = post.data;

const { Content, headings } = await render(post);
const tocHeadings = headings.filter((heading) => heading.depth <= 3 && heading.slug !== "footnote-label");
const dates = getArticleDates(pubDatetime, modDatetime);
const dateLabel = (date: Date) => formatSiteDate(date, locale);
const readingMinutes = estimateReadingMinutes(post.body);
const readingWords = countReadingWords(post.body);

const languageRoutes = BILINGUAL_ENABLED ? await languagePaths(Astro.url.pathname) : {};
const hasExactTranslation = Object.keys(languageRoutes).length === 2;
const translationHref = hasExactTranslation ? switchDestination(Astro.url.pathname, languageRoutes) : undefined;

const VISIBLE_TAG_LIMIT = 5;
const latestDate = dates.updated ?? dates.published;
const ageYears = Math.floor((Date.now() - latestDate.getTime()) / (365.25 * 24 * 60 * 60 * 1000));
const showOutdatedNotice = !evergreen && latestDate.getTime() > 0 && ageYears >= 2;

const canonicalHref = canonicalURL ? new URL(canonicalURL, Astro.site ?? Astro.url.origin).href : Astro.url.href;
const markdownPayload = JSON.stringify(cleanArticleMarkdownForCopy(title, canonicalHref, post.body)).replace(
  /</g,
  "\\u003c",
);

const inferResourceKind = (url: string, icon?: string) => {
  if (icon) return icon;
  if (/github\.com/i.test(url)) return "github";
  if (/arxiv\.org|doi\.org|\.pdf$/i.test(url)) return "paper";
  return "link";
};

const formatResourceNote = (url: string, note?: string) => {
  if (note) return note;
  try {
    const parsed = new URL(url);
    const cleanPath = parsed.pathname.replace(/\/+$/, "");
    const host = parsed.hostname.replace(/^www\./, "");
    return cleanPath && cleanPath !== "/" ? `${host}${cleanPath}` : host;
  } catch {
    return url;
  }
};

const ogImagePath = resolvePostOgImagePath(post, postSlug, locale);
const ogImage = ogImagePath ? new URL(ogImagePath, Astro.url.origin).href : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  scrollSmooth: true,
  referrerPolicy: "no-referrer",
};

/* ========== Prev/Next Posts ========== */

const allPosts = posts.map((item) => ({
  id: item.id,
  title: item.data.title,
  filePath: item.filePath,
  slug: resolveLegacyPostSlug(item),
}));

const currentPostIndex = allPosts.findIndex((a) => a.id === post.id);

const prevPost = currentPostIndex > 0 ? allPosts[currentPostIndex - 1] : null;
const nextPost =
  currentPostIndex >= 0 && currentPostIndex < allPosts.length - 1 ? allPosts[currentPostIndex + 1] : null;
---

<Layout {...layoutProps}>
  <Header />
  <BackButton currentTitle={title} />
  <main
    id="main-content"
    transition:name="reading-surface"
    transition:animate={readingTransition}
    class:list={["post-page app-layout relative pb-12", { "mt-8": !SITE.showBackButton }]}
    data-reading-minutes={readingMinutes}
    data-reading-back-default={localizedPath("/blog/", locale)}
    data-pagefind-body
  >
    <!-- Post header section -->
    <header class="post-header">
      <p class="post-kicker" data-pagefind-ignore>
        <span aria-hidden="true"></span>{t.writing}
      </p>
      <h1
        transition:name={articleTransitionName(postPath(post.id, post.filePath, postSlug))}
        transition:animate="initial"
        data-article-title
        class="post-title"
      >
        {title}
      </h1>
      <p class="post-description">{description}</p>
      <div class="post-meta">
        <span>{author}</span>
        <span aria-hidden="true">·</span>
        <span class="post-date"
          >{t.published} <time datetime={dates.published.toISOString()}>{dateLabel(dates.published)}</time></span
        >
        {
          dates.updated && (
            <span class="post-date post-date-updated">
              {t.updated} <time datetime={dates.updated.toISOString()}>{dateLabel(dates.updated)}</time>
            </span>
          )
        }
        <span aria-hidden="true">·</span>
        {
          readingWords > 0 && (
            <>
              <span class="post-word-count">{t.wordCount(readingWords)}</span>
              <span aria-hidden="true">·</span>
            </>
          )
        }
        <span class="post-reading-time">{t.readingTime(readingMinutes)}</span>
        {
          translationHref && (
            <>
              <span aria-hidden="true">·</span>
              <a href={translationHref} data-article-translation class="post-translation-link" data-pagefind-ignore>
                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.9"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="10" />
                  <path d="M2 12h20" />
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                </svg>
                <span>{t.readInOtherLocale}</span>
                <span aria-hidden="true">↗</span>
              </a>
            </>
          )
        }
      </div>
      <div class="post-header-bar" data-pagefind-ignore>
        <div class="post-header-tags">
          {
            tags.slice(0, VISIBLE_TAG_LIMIT).map((tag: string) => (
              <a href={getLocalizedTagPath(tag, locale)} class="post-tag-badge">
                <span aria-hidden="true">#</span>
                {tag}
              </a>
            ))
          }
          {
            tags.slice(VISIBLE_TAG_LIMIT).map((tag: string) => (
              <a href={getLocalizedTagPath(tag, locale)} class="post-tag-badge" hidden data-extra-tag>
                <span aria-hidden="true">#</span>
                {tag}
              </a>
            ))
          }
          {
            tags.length > VISIBLE_TAG_LIMIT && (
              <button type="button" class="post-tag-more" data-tags-expand aria-expanded="false">
                {t.moreTags(tags.length)}
              </button>
            )
          }
        </div>
        <button
          type="button"
          class="post-copy-md-btn"
          data-copy-article-md
          data-label-default={t.copyMarkdown}
          data-label-copied={t.copiedCheck}
          title={t.copyArticleMarkdown}
          aria-label={t.copyArticleMarkdown}
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="9" y="9" width="13" height="13" rx="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
          </svg>
          <span data-copy-md-text>{t.copyMarkdown}</span>
        </button>
      </div>
    </header>

    <div class="post-reading">
      <div class="post-reading-content">
        <PostToc headings={tocHeadings} variant="inline" />
        {
          showOutdatedNotice && (
            <aside class="post-outdated-banner" role="note" data-pagefind-ignore>
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
              </svg>
              <span>{t.outdatedNotice(ageYears)}</span>
            </aside>
          )
        }
        {
          links && links.length > 0 && (
            <nav class="post-resources" aria-label={t.resourceLinksLabel} data-pagefind-ignore>
              {links.map((item) => {
                const kind = inferResourceKind(item.url, item.icon);
                return (
                  <a href={item.url} target="_blank" rel="noopener noreferrer" class="post-resource-card">
                    <span class="post-resource-icon" aria-hidden="true">
                      {kind === "github" ? (
                        <svg viewBox="0 0 24 24" fill="currentColor">
                          <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.08 1.85 1.24 1.85 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .5Z" />
                        </svg>
                      ) : kind === "plugin" ? (
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12 2v5" />
                          <path d="M8 7h8a2 2 0 0 1 2 2v3a6 6 0 0 1-12 0V9a2 2 0 0 1 2-2Z" />
                          <path d="M12 18v4" />
                        </svg>
                      ) : kind === "demo" ? (
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="10" />
                          <polygon points="10 8 16 12 10 16 10 8" />
                        </svg>
                      ) : kind === "paper" || kind === "docs" ? (
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                          <polyline points="14 2 14 8 20 8" />
                        </svg>
                      ) : (
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                        </svg>
                      )}
                    </span>
                    <span class="post-resource-body">
                      <span class="post-resource-label">{item.label}</span>
                      <span class="post-resource-note">{formatResourceNote(item.url, item.note)}</span>
                    </span>
                    <span class="post-resource-arrow" aria-hidden="true">
                      ↗
                    </span>
                  </a>
                );
              })}
            </nav>
          )
        }
        <article
          id="article"
          class="app-prose prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg) w-full"
        >
          <Content />
        </article>
      </div>
    </div>
    <script type="application/json" id="article-markdown-source" data-pagefind-ignore is:inline set:html={markdownPayload} />

    <!-- ═══════ Post footer section ═══════ -->
    <div class="mt-10 flex items-center gap-3" aria-hidden="true">
      <div class="from-accent/20 via-border/30 h-px flex-1 bg-linear-to-r to-transparent"></div>
      <span class="font-cartograph text-accent/25 text-[10px] tracking-widest uppercase select-none">// {t.end}</span>
      <div class="via-border/30 to-accent/20 h-px flex-1 bg-linear-to-r from-transparent"></div>
    </div>

    <EditPost class="mt-4" {hideEditPost} {post} />

    <!-- Tags & Share row -->
    <div class="mt-6 mb-8 flex flex-col items-center gap-6 sm:flex-row sm:items-start sm:justify-between">
      <!-- Tags -->
      <div class="flex flex-wrap justify-center gap-2 sm:justify-start">
        {
          tags.map((tag: string) => (
            <a
              href={getLocalizedTagPath(tag, locale)}
              class="border-border-subtle bg-surface/75 font-cartograph hover:border-accent/40 hover:bg-accent/5 hover:text-accent inline-flex items-center gap-1 rounded-full border px-2.5 py-1 text-xs transition-all duration-200"
            >
              <span class="opacity-45">#</span>
              {tag}
            </a>
          ))
        }
      </div>

      <!-- Share links -->
      <ShareLinks />
    </div>

    <PostDiscovery {post} {posts} />

    <GiscusComments />

    <!-- Decorative separator before prev/next -->
    <div class="my-6 flex items-center gap-3" aria-hidden="true">
      <div class="via-border/30 h-px flex-1 bg-linear-to-r from-transparent to-transparent"></div>
    </div>

    <!-- Previous/Next Post Navigation -->
    <div data-pagefind-ignore class="grid grid-cols-2 gap-3">
      {
        prevPost ? (
          <a
            href={postPath(prevPost.id, prevPost.filePath, prevPost.slug)}
            data-reading-link
            class="post-nav-link group border-border/20 hover:border-accent/30 hover:shadow-accent/5 relative flex flex-col gap-1 rounded-2xl border px-5 py-4 transition-all duration-300 hover:shadow-lg"
          >
            <div class="flex items-center gap-1.5">
              <IconArrowLeft
                class="text-accent/50 size-3.5 transition-transform duration-300 group-hover:-translate-x-1 rtl:rotate-180"
                aria-hidden="true"
              />
              <span class="font-cartograph text-muted-foreground text-[10px] tracking-wider uppercase">
                {t.previous}
              </span>
            </div>
            <span
              data-reading-title
              class="text-foreground/80 group-hover:text-accent line-clamp-2 text-sm leading-snug font-medium transition-colors duration-200"
            >
              {prevPost.title}
            </span>
          </a>
        ) : (
          <div />
        )
      }
      {
        nextPost && (
          <a
            href={postPath(nextPost.id, nextPost.filePath, nextPost.slug)}
            data-reading-link
            class="post-nav-link group border-border/20 hover:border-accent/30 hover:shadow-accent/5 relative col-start-2 flex flex-col items-end gap-1 rounded-2xl border px-5 py-4 text-end transition-all duration-300 hover:shadow-lg"
          >
            <div class="flex items-center gap-1.5">
              <span class="font-cartograph text-muted-foreground text-[10px] tracking-wider uppercase">{t.next}</span>
              <IconArrowRight
                class="text-accent/50 size-3.5 transition-transform duration-300 group-hover:translate-x-1 rtl:rotate-180"
                aria-hidden="true"
              />
            </div>
            <span
              data-reading-title
              class="text-foreground/80 group-hover:text-accent line-clamp-2 text-sm leading-snug font-medium transition-colors duration-200"
            >
              {nextPost.title}
            </span>
          </a>
        )
      }
    </div>
  </main>
  <PostToc headings={tocHeadings} variant="mobile" />
  <ArticleLightbox />
  <BackToTopButton />
  <Footer />
</Layout>

<script src="../scripts/post-enhancements.ts"></script>
