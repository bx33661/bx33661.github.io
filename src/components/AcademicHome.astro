---
import { getCollection, type CollectionEntry } from "astro:content";
import { SITE } from "@/config.ts";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import { resolveLegacyPostSlug } from "@/utils/legacySlug";

const posts = getSortedPosts(await getCollection("blog"));
const selectedSlugs = [
  "codeql-learning",
  "cnvd-2026-20654-lg-nas-rce",
  "ntlm-protocol-and-attack-techniques",
];
const recentPosts = posts
  .filter((post) => !selectedSlugs.includes(post.data.slug ?? ""))
  .slice(0, 2);
const selectedPosts = selectedSlugs.flatMap((slug) => {
  const post = posts.find((item) => item.data.slug === slug);
  return post ? [post] : [];
});
const postHref = (post: CollectionEntry<"blog">) =>
  getPath(post.id, post.filePath, true, resolveLegacyPostSlug(post));
const formatYear = (date: Date) => String(date.getFullYear());
const formatDate = (date: Date) =>
  `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, "0")}.${String(date.getDate()).padStart(2, "0")}`;
const work = (await getCollection("projects"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => entry.data);
const awards = (await getCollection("awards"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => entry.data);
const featuredProject = work.find((project) => project.feature);
const featuredDetails = featuredProject?.feature;
---

<main id="main-content" class="app-layout academic-home">
  <section class="hero" aria-labelledby="home-title">
    <div class="hero-main">
      <p class="eyebrow"><span class="signal" aria-hidden="true"></span> RESEARCHER / DEVELOPER</p>
      <h1 id="home-title">Zhang Boxiang <span>张博翔</span></h1>
      <p class="hero-role">Information Security · Hainan University</p>
      <p class="hero-copy">
        I investigate software and network vulnerabilities with program analysis, AI-assisted tooling and reproducible evidence.
      </p>
      <div class="hero-links" aria-label="Contact and profiles">
        <a class="primary-link" href="mailto:bx33661@gmail.com">Email me <span aria-hidden="true">↗</span></a>
        <a href={SITE.profile} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        <a href="/blog/">Writing <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <aside class="hero-aside" aria-label="Academic degrees">
      <div class="monogram" aria-hidden="true">BX<span>.</span></div>
      <div class="aside-rule"></div>
      <p class="aside-label">BACHELOR'S DEGREE</p>
      <p class="aside-value">Hainan University <span>海南大学 · HNU</span></p>
      <p class="aside-label next-label">MASTER'S DEGREE</p>
      <p class="aside-value">University of Chinese Academy of Sciences <span>中国科学院大学 · UCAS</span></p>
    </aside>
  </section>

  <section class="home-section interests" aria-labelledby="interests-title">
    <div class="section-intro">
      <p class="section-index">01 / RESEARCH</p>
      <h2 id="interests-title">Research interests <span>研究方向</span></h2>
    </div>
    <div class="interest-copy">
      <p>From vulnerable code paths to packet-level evidence, I build tools that make security findings easier to verify.</p>
      <div class="interest-tags" aria-label="Research topics">
        <span>AI-assisted code auditing</span><span>Vulnerability research</span><span>Protocol analysis</span>
      </div>
      {featuredProject && featuredDetails && <article class="research-proof" aria-label={`Featured research: ${featuredProject.name}`}>
        <h3>{featuredProject.name} <span>Featured research</span></h3>
        <dl>
          <div><dt>Question</dt><dd>{featuredDetails.question}</dd></div>
          <div><dt>Method</dt><dd>{featuredDetails.method}</dd></div>
          <div><dt>Evidence</dt><dd>{featuredDetails.evidence}</dd></div>
          <div><dt>Output</dt><dd><a href={featuredProject.href} target="_blank" rel="noopener noreferrer">View code and methodology ↗</a></dd></div>
        </dl>
      </article>}
    </div>
  </section>

  <section class="home-section education-section" aria-labelledby="education-title">
    <p class="section-index">02 / EDUCATION</p>
    <h2 id="education-title">Education <span>教育经历</span></h2>
    <ol class="education-list">
      <li><img src="/schools/ucas-emblem.webp" width="48" height="48" alt="" loading="lazy" /><div><p class="education-years">2027 —</p><h3>University of Chinese Academy of Sciences</h3><p>Master's Degree · UCAS · 中国科学院大学</p></div></li>
      <li><img src="/schools/hainan-university-emblem.webp" width="48" height="48" alt="" loading="lazy" /><div><p class="education-years">2023 — 2027</p><h3>Hainan University</h3><p>Bachelor's Degree in Information Security · HNU · 海南大学</p></div></li>
    </ol>
  </section>

  <section class="home-section work-section" aria-labelledby="work-title">
    <div class="section-head">
      <div><p class="section-index">03 / PROJECTS</p><h2 id="work-title">Selected work <span>代表项目</span></h2></div>
      <p class="section-note">Open-source research and engineering.</p>
    </div>
    <div class="work-list">
      {work.map((item) => (
        <article class="work-entry">
          <span class="entry-number">{item.number}</span>
          <div class="work-body">
            <p class="work-category">{item.category}</p>
            <h3>{item.name}</h3>
            <p>{item.description}</p>
          </div>
          <a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={`${item.linkLabel}: ${item.name}`}>
            {item.linkLabel} <span aria-hidden="true">↗</span>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="home-section awards-section" aria-labelledby="awards-title">
    <div class="section-head">
      <div><p class="section-index">04 / HONORS</p><h2 id="awards-title">Honors &amp; awards <span>竞赛荣誉</span></h2></div>
      <p class="section-note">Selected competition results.</p>
    </div>
    <ol class="awards-list">
      {awards.map((award) => (
        <li>
          <span class="award-year">{award.year}</span>
          <strong>{award.distinction}</strong>
          <span class="award-competition">{award.competition}</span>
        </li>
      ))}
    </ol>
  </section>

  <div class="lower-grid">
    <section class="home-section writing-section" aria-labelledby="writing-title">
      <div class="section-head">
        <div><p class="section-index">05 / WRITING</p><h2 id="writing-title">Selected writing <span>研究笔记精选</span></h2></div>
        <a class="text-link" href="/blog/">All posts <span aria-hidden="true">↗</span></a>
      </div>
      <ol class="selected-list">
        {selectedPosts.map((post) => (
          <li><a href={postHref(post)}><span class="writing-year">{formatYear(post.data.pubDatetime)}</span><span class="writing-copy"><span class="writing-title">{post.data.title}</span><span class="writing-summary">{post.data.description}</span></span><span class="writing-arrow" aria-hidden="true">↗</span></a></li>
        ))}
      </ol>
    </section>
  </div>

  <section class="home-section updates-section" aria-labelledby="updates-title">
    <div class="section-head">
      <div><p class="section-index">06 / LATEST</p><h2 id="updates-title">Recent updates <span>最近更新</span></h2></div>
      <a class="text-link" href="/blog/">Writing archive <span aria-hidden="true">↗</span></a>
    </div>
    <ol class="updates-list">
      {recentPosts.map((post) => (
        <li><time datetime={post.data.pubDatetime.toISOString()}>{formatDate(post.data.pubDatetime)}</time><span class="update-type">ARTICLE</span><a href={postHref(post)}>{post.data.title} <span aria-hidden="true">↗</span></a></li>
      ))}
      <li><time datetime="2026-05">2026.05</time><span class="update-type">HONOR</span><span>National Second Prize · 中国高校智能机器人创意大赛软件系统安全赛</span></li>
      <li><span class="update-undated">ONGOING</span><span class="update-type">PROJECT</span><a href="https://github.com/bx33661/Wireshark-MCP" target="_blank" rel="noopener noreferrer">Wireshark-MCP · open-source development <span aria-hidden="true">↗</span></a></li>
    </ol>
  </section>
</main>

<style>
  .academic-home { --home-muted: #59616b; padding-top: clamp(2.3rem, 4vw, 4.2rem); padding-bottom: 5rem; }
  :global(html[data-theme="dark"]) .academic-home { --home-muted: #aab5c3; }
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) 15.5rem; gap: clamp(2rem, 5vw, 5rem); padding-bottom: clamp(2.7rem, 4vw, 4rem); border-bottom: 1px solid color-mix(in srgb, var(--foreground) 18%, transparent); }
  .eyebrow, .section-index, .aside-label, .work-category, .education-years, .entry-number, .writing-year, .updates-list time { font-family: var(--font-cartograph), ui-monospace, monospace; font-size: .69rem; font-weight: 600; letter-spacing: .11em; }
  .eyebrow { display: flex; align-items: center; gap: .6rem; margin: 0 0 1.55rem; color: var(--accent); }
  .signal { width: .42rem; height: .42rem; border-radius: 50%; background: var(--accent); }
  .hero h1 { margin: 0; font-size: clamp(2.6rem, 6vw, 4.7rem); line-height: 1.08; letter-spacing: -.055em; font-weight: 700; }
  .hero h1 span { display: inline-block; margin-left: .45rem; color: var(--home-muted); font-size: clamp(1.15rem, 2.5vw, 1.75rem); font-weight: 500; letter-spacing: -.025em; vertical-align: .18em; }
  .hero-role { margin: 1.25rem 0 0; font-size: clamp(1rem, 1.7vw, 1.2rem); font-weight: 600; line-height: 1.5; }
  .hero-copy { max-width: 62ch; margin: 1.2rem 0 0; color: var(--home-muted); font-size: .98rem; line-height: 1.8; }
  .hero-links { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.5rem; margin-top: 2rem; }
  .hero-links a, .text-link, .work-entry > a { color: var(--accent); font-size: .83rem; font-weight: 650; text-decoration: none; }
  .hero-links a:hover, .text-link:hover, .work-entry > a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .hero-links .primary-link { display: inline-flex; align-items: center; gap: 1.2rem; padding: .7rem 1rem; border: 1px solid var(--accent); border-radius: .25rem; background: var(--accent); color: var(--background); }
  .hero-links .primary-link:hover { background: color-mix(in srgb, var(--accent) 83%, black); text-decoration: none; }
  .hero-aside { padding-top: .25rem; }
  .monogram { font-family: Georgia, serif; font-size: clamp(4.2rem, 7vw, 6.5rem); line-height: 1; letter-spacing: -.09em; font-weight: 700; }
  .monogram span { color: var(--accent); }
  .aside-rule { width: 3.5rem; height: 2px; margin: 1.8rem 0 1.5rem; background: var(--accent); }
  .aside-label { margin: 0 0 .55rem; color: var(--accent); }
  .aside-value { margin: 0; font-size: .88rem; font-weight: 650; line-height: 1.5; }
  .aside-value span { display: block; margin-top: .25rem; color: var(--home-muted); font-size: .75rem; font-weight: 400; }
  .next-label { margin-top: 1.65rem; }
  .home-section { padding-top: 2.6rem; }
  .section-index { margin: 0 0 .75rem; color: var(--accent); }
  .home-section h2 { margin: 0; font-size: clamp(1.4rem, 2vw, 1.75rem); line-height: 1.25; letter-spacing: -.035em; }
  .home-section h2 span { margin-left: .5rem; color: var(--home-muted); font-size: .76rem; font-weight: 500; letter-spacing: 0; vertical-align: .14em; }
  .interests { display: grid; grid-template-columns: 15.5rem minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); padding-bottom: 2.5rem; border-bottom: 1px solid color-mix(in srgb, var(--foreground) 14%, transparent); }
  .interest-copy > p { max-width: 67ch; margin: .1rem 0 0; color: var(--home-muted); font-size: .91rem; line-height: 1.7; }
  .interest-copy strong { color: var(--foreground); font-weight: 650; }
  .interest-tags { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.35rem; }
  .interest-tags span { padding: .34rem .55rem; border: 1px solid color-mix(in srgb, var(--foreground) 19%, transparent); border-radius: .2rem; font-size: .72rem; }
  .research-proof { margin-top: 1.4rem; padding: 1rem 1.1rem; border-left: 3px solid var(--accent); background: color-mix(in srgb, var(--accent) 5%, var(--background)); }
  .research-proof h3 { display: flex; flex-wrap: wrap; align-items: baseline; gap: .7rem; margin: 0 0 .8rem; font-size: 1rem; }
  .research-proof h3 span { color: var(--home-muted); font-size: .7rem; font-weight: 500; }
  .research-proof dl { display: grid; grid-template-columns: 1fr 1fr; gap: .65rem 1rem; margin: 0; }
  .research-proof dt { color: var(--accent); font-family: var(--font-cartograph), ui-monospace, monospace; font-size: .66rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .research-proof dd { margin: .18rem 0 0; color: var(--home-muted); font-size: .75rem; line-height: 1.5; }
  .research-proof a { color: var(--accent); font-weight: 650; text-underline-offset: 3px; }
  .section-head { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 1.5rem; }
  .section-note { margin: 0 0 .2rem; color: var(--home-muted); font-size: .78rem; }
  .work-list { border-top: 1px solid color-mix(in srgb, var(--foreground) 21%, transparent); }
  .work-entry { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr) 6.5rem; gap: 1rem; align-items: start; padding: 1.55rem 0; border-bottom: 1px solid color-mix(in srgb, var(--foreground) 16%, transparent); }
  .entry-number { padding-top: .28rem; color: var(--accent); }
  .work-category { margin: 0 0 .4rem; color: var(--accent); font-size: .64rem; }
  .work-body h3 { margin: 0; font-size: 1.23rem; letter-spacing: -.025em; }
  .work-body > p:last-child { max-width: 72ch; margin: .5rem 0 0; color: var(--home-muted); font-size: .88rem; line-height: 1.7; }
  .work-entry > a { justify-self: end; padding-top: .23rem; white-space: nowrap; }
  .awards-section { padding-top: 2.9rem; }
  .awards-list { margin: 0; padding: 0; border-top: 1px solid color-mix(in srgb, var(--foreground) 21%, transparent); list-style: none; }
  .awards-list li { display: grid; grid-template-columns: 3.5rem minmax(0, .85fr) minmax(0, 1.45fr); gap: 1rem; align-items: baseline; padding: .95rem 0; border-bottom: 1px solid color-mix(in srgb, var(--foreground) 15%, transparent); }
  .award-year { color: var(--accent); font-family: var(--font-cartograph), ui-monospace, monospace; font-size: .7rem; font-weight: 600; }
  .awards-list strong { font-size: .85rem; font-weight: 650; line-height: 1.5; }
  .award-competition { color: var(--home-muted); font-size: .82rem; line-height: 1.55; }
  .lower-grid { padding-top: 2.5rem; }
  .lower-grid .home-section { padding-top: 0; }
  .writing-section .section-head { margin-bottom: 1rem; }
  .selected-list, .education-list, .updates-list { margin: 0; padding: 0; list-style: none; }
  .selected-list { border-top: 1px solid color-mix(in srgb, var(--foreground) 21%, transparent); }
  .selected-list a { display: grid; grid-template-columns: 2.7rem minmax(0, 1fr) 1rem; gap: .65rem; align-items: start; padding: 1rem .15rem; border-bottom: 1px solid color-mix(in srgb, var(--foreground) 15%, transparent); color: var(--foreground); text-decoration: none; }
  .selected-list a:hover .writing-title, .updates-list a:hover { color: var(--accent); }
  .writing-year { color: var(--home-muted); letter-spacing: 0; }
  .writing-copy { display: block; min-width: 0; }
  .writing-title { display: block; font-size: .88rem; font-weight: 600; line-height: 1.55; transition: color .2s; }
  .writing-summary { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; margin-top: .22rem; color: var(--home-muted); font-size: .75rem; line-height: 1.6; }
  .writing-arrow { color: var(--accent); }
  .education-list { margin-top: 1rem; border-top: 1px solid color-mix(in srgb, var(--foreground) 21%, transparent); }
  .education-list li { display: grid; grid-template-columns: 2.6rem minmax(0, 1fr); gap: .8rem; align-items: start; padding: .9rem 0; border-bottom: 1px solid color-mix(in srgb, var(--foreground) 15%, transparent); }
  .education-list img { width: 2.6rem; height: 2.6rem; object-fit: contain; }
  .education-years { margin: 0 0 .45rem; color: var(--accent); font-size: .65rem; }
  .education-list h3 { margin: 0; font-size: .87rem; line-height: 1.45; }
  .education-list li div > p:last-child { margin: .3rem 0 0; color: var(--home-muted); font-size: .74rem; line-height: 1.5; }
  .updates-section { margin-top: 3rem; border-top: 1px solid color-mix(in srgb, var(--foreground) 18%, transparent); }
  .updates-list { border-top: 1px solid color-mix(in srgb, var(--foreground) 21%, transparent); }
  .updates-list li { display: grid; grid-template-columns: 6rem 4rem minmax(0, 1fr); gap: .75rem; align-items: baseline; padding: .8rem .1rem; border-bottom: 1px solid color-mix(in srgb, var(--foreground) 14%, transparent); }
  .updates-list time, .update-undated { color: var(--home-muted); font-family: var(--font-cartograph), ui-monospace, monospace; font-size: .69rem; font-weight: 600; letter-spacing: 0; }
  .update-type { color: var(--accent); font-family: var(--font-cartograph), ui-monospace, monospace; font-size: .63rem; font-weight: 700; letter-spacing: .05em; }
  .updates-list li > span:last-child { font-size: .82rem; line-height: 1.5; }
  .updates-list a { color: var(--foreground); font-size: .82rem; line-height: 1.5; text-decoration: none; }
  @media (max-width: 780px) {
    .hero { grid-template-columns: 1fr; gap: 1.2rem; padding-bottom: 1.5rem; }
    .hero-aside { display: grid; grid-template-columns: 1fr 1fr; gap: .35rem .8rem; align-items: start; padding-top: .9rem; border-top: 1px solid color-mix(in srgb, var(--foreground) 14%, transparent); }
    .monogram, .aside-rule { display: none; }
    .next-label { margin-top: 0; }
    .aside-value { grid-row: 2; }
    .interests { grid-template-columns: 1fr; gap: .7rem; padding-bottom: 1.4rem; }
    .awards-list li { grid-template-columns: 3rem minmax(0, 1fr); gap: .25rem .8rem; }
    .award-competition { grid-column: 2; }
  }
  @media (max-width: 480px) {
    .academic-home { padding-top: 1.2rem; padding-bottom: 3rem; }
    .eyebrow { margin-bottom: .8rem; }
    .hero h1 { font-size: clamp(2.15rem, 9vw, 2.6rem); }
    .hero h1 span { display: inline-block; margin: 0 0 0 .3rem; font-size: 1rem; vertical-align: .15em; }
    .hero-role { margin-top: .65rem; font-size: .9rem; }
    .hero-copy { margin-top: .65rem; font-size: .86rem; line-height: 1.55; }
    .hero-links { margin-top: 1rem; gap: .5rem 1rem; }
    .hero-links .primary-link { padding: .5rem .7rem; }
    .hero-aside { grid-template-columns: 1fr 1fr; gap: .2rem .65rem; }
    .hero-aside .aside-value { font-size: .7rem; line-height: 1.35; }
    .aside-value span { font-size: .68rem; }
    .aside-label { font-size: .58rem; letter-spacing: .05em; }
    .home-section { padding-top: 1.5rem; }
    .research-proof { margin-top: .9rem; padding: .8rem; }
    .research-proof dl { grid-template-columns: 1fr; gap: .45rem; }
    .interest-tags { margin-top: .8rem; }
    .interest-tags span { font-size: .66rem; padding: .25rem .4rem; }
    .section-head { align-items: start; }
    .section-note { display: none; }
    .work-entry { grid-template-columns: 2rem minmax(0, 1fr); gap: .5rem; }
    .work-entry > a { grid-column: 2; justify-self: start; padding-top: .5rem; }
    .selected-list a { grid-template-columns: 2.5rem minmax(0, 1fr) .8rem; gap: .4rem; }
    .updates-list li { grid-template-columns: 4.5rem 3.2rem minmax(0, 1fr); gap: .35rem; }
    .updates-list time, .update-undated { font-size: .61rem; }
    .update-type { font-size: .57rem; }
    .text-link { font-size: .75rem; text-align: right; }
  }
  @media (prefers-reduced-motion: reduce) { .writing-title { transition: none; } }
</style>
