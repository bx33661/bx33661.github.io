---
import { localeFromPath } from "@/i18n";
import { ui } from "@/i18n/ui";

const locale = localeFromPath(Astro.url.pathname);
const t = ui(locale);

type Heading = { depth: number; slug: string; text: string };
type Props = { headings: Heading[]; variant: "inline" | "sidebar" | "mobile"; _listOnly?: boolean };

const { headings, variant, _listOnly = false } = Astro.props;
---

{
  headings.length > 0 &&
    (_listOnly ? (
      <ol>
        {headings.map((heading) => (
          <li class:list={[{ nested: heading.depth >= 3 }]}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    ) : variant === "inline" ? (
      <details class="post-toc-inline">
        <summary>
          {t.toc} <span>{t.tocCount(headings.length)}</span>
        </summary>
        <nav aria-label={t.tocInline} data-post-toc>
          <Astro.self headings={headings} variant={variant} _listOnly />
        </nav>
      </details>
    ) : variant === "sidebar" ? (
      <aside class="post-toc-sidebar" aria-label={t.tocQuick}>
        <p>{t.toc}</p>
        <nav aria-label={t.tocSidebar} data-post-toc>
          <Astro.self headings={headings} variant={variant} _listOnly />
        </nav>
      </aside>
    ) : (
      <div class="post-toc-mobile">
        <button type="button" data-post-toc-open aria-haspopup="dialog" aria-controls="post-toc-dialog">
          <span class="post-toc-mobile-label">{t.tocShort}</span>
          <span data-toc-current>{t.toc}</span>
        </button>
        <dialog id="post-toc-dialog" aria-labelledby="post-toc-dialog-title" data-pagefind-ignore>
          <header>
            <h2 id="post-toc-dialog-title">{t.toc}</h2>
            <button type="button" data-post-toc-close aria-label={t.closeToc}>
              {t.close} ×
            </button>
          </header>
          <nav aria-label={t.tocMobile} data-post-toc>
            <Astro.self headings={headings} variant={variant} _listOnly />
          </nav>
        </dialog>
      </div>
    ))
}

<style>
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.8rem 0;
    color: var(--foreground);
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
  }
  summary span,
  .post-toc-sidebar p {
    font-size: 0.72rem;
    font-weight: 400;
  }
  nav {
    max-height: 65vh;
    overflow-y: auto;
    scrollbar-width: thin;
  }
  ol {
    margin: 0;
    padding: 0 0 0.9rem;
    list-style: none;
  }
  li {
    margin: 0.28rem 0;
  }
  li.nested {
    padding-left: 0.85rem;
  }
  a {
    display: block;
    color: var(--muted-foreground);
    font-size: 0.78rem;
    line-height: 1.45;
    text-decoration: none;
  }
  li:not(.nested) a {
    font-weight: 500;
  }
  li.nested a {
    font-size: 0.74rem;
    opacity: 0.92;
  }
  a:hover,
  a:focus-visible {
    color: var(--accent);
  }
  .post-toc-sidebar {
    display: none;
  }
  .post-toc-sidebar p {
    margin: 0 0 0.65rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  .post-toc-sidebar ol {
    padding: 0;
  }
</style>
