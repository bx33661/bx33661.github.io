---
type Heading = { depth: number; slug: string; text: string };
type Props = { headings: Heading[]; variant: "inline" | "sidebar" | "mobile" };

const { headings, variant } = Astro.props;
---

{
  headings.length > 0 &&
    (variant === "inline" ? (
      <details class="post-toc-inline">
        <summary>
          本文目录 <span>{headings.length} 个章节</span>
        </summary>
        <nav aria-label="正文内嵌目录" data-post-toc>
          <ol>
            {headings.map((heading) => (
              <li class:list={[{ nested: heading.depth >= 3 }]}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
    ) : variant === "sidebar" ? (
      <aside class="post-toc-sidebar" aria-label="文章快速目录">
        <p>本文目录</p>
        <nav aria-label="正文侧边目录" data-post-toc>
          <ol>
            {headings.map((heading) => (
              <li class:list={[{ nested: heading.depth >= 3 }]}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>
    ) : (
      <div class="post-toc-mobile">
        <button
          type="button"
          data-post-toc-open
          aria-haspopup="dialog"
          aria-controls="post-toc-dialog"
        >
          <>
            <span class="post-toc-mobile-label">目录</span>
            <span data-toc-current>本文目录</span>
          </>
        </button>
        <dialog
          id="post-toc-dialog"
          aria-labelledby="post-toc-dialog-title"
          data-pagefind-ignore
        >
          <header>
            <>
              <h2 id="post-toc-dialog-title">本文目录</h2>
              <button
                type="button"
                data-post-toc-close
                aria-label="关闭本文目录"
              >
                关闭 ×
              </button>
            </>
          </header>
          <nav aria-label="移动端快速目录" data-post-toc>
            <ol>
              {headings.map((heading) => (
                <li class:list={[{ nested: heading.depth >= 3 }]}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </dialog>
      </div>
    ))
}

<style>
  .post-toc-inline {
    margin: 0 0 1.9rem;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 30%, transparent);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.8rem 0;
    color: var(--foreground);
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
  }
  summary span,
  .post-toc-sidebar p {
    color: color-mix(in srgb, var(--foreground) 48%, transparent);
    font-size: 0.72rem;
    font-weight: 400;
  }
  nav {
    max-height: 65vh;
    overflow-y: auto;
  }
  ol {
    margin: 0;
    padding: 0 0 0.9rem;
    list-style: none;
  }
  li {
    margin: 0.3rem 0;
  }
  li.nested {
    padding-left: 0.85rem;
  }
  a {
    display: block;
    color: color-mix(in srgb, var(--foreground) 65%, transparent);
    font-size: 0.78rem;
    line-height: 1.45;
    text-decoration: none;
  }
  a:hover,
  a:focus-visible {
    color: var(--accent);
  }
  .post-toc-sidebar {
    display: none;
  }
  .post-toc-sidebar p {
    margin: 0 0 0.65rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  .post-toc-sidebar ol {
    padding: 0;
  }
  @media (min-width: 1500px) {
    .post-toc-inline {
      display: none;
    }
    .post-toc-sidebar {
      position: sticky;
      top: 6rem;
      display: block;
      align-self: start;
      padding-left: 1rem;
      border-left: 1px solid color-mix(in srgb, var(--border) 30%, transparent);
    }
  }
  :global(html[data-theme="dark"]) summary span,
  :global(html[data-theme="dark"]) .post-toc-sidebar p {
    color: color-mix(in srgb, var(--foreground) 68%, transparent);
  }
</style>
