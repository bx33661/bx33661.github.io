---
import { articleCopy } from "@/i18n/articles";
import { localeFromPath } from "@/i18n";
import { SCENARIO_TABS, TRUST_SCENARIOS, type ScenarioId, type ScenarioSpec } from "@/data/trust-boundary";
import { serializeJsonLd } from "@/utils/serializeJsonLd";
import "@/styles/trust-boundary-simulator.css";

interface Props {
  locale?: "en" | "zh-CN";
}

const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const t = (text: string) => articleCopy(locale, text);

const translatedScenarios = Object.fromEntries(
  (Object.entries(TRUST_SCENARIOS) as [ScenarioId, ScenarioSpec][]).map(([id, spec]) => [
    id,
    {
      attackerPayload: t(spec.attackerPayload),
      inputTitle: t(spec.inputTitle),
      inputDetail: t(spec.inputDetail),
      boundaryClass: spec.boundaryClass,
      boundaryText: t(spec.boundaryText),
      sourceTitle: t(spec.sourceTitle),
      sourceDetail: t(spec.sourceDetail),
      sinkTitle: t(spec.sinkTitle),
      sinkDetail: t(spec.sinkDetail),
      llmBadge: t(spec.llmBadge),
      llmHeadline: t(spec.llmHeadline),
      llmDesc: t(spec.llmDesc),
      realityBadge: t(spec.realityBadge),
      realityHeadline: t(spec.realityHeadline),
      realityDesc: t(spec.realityDesc),
    },
  ]),
) as Record<ScenarioId, ScenarioSpec>;

const initial = translatedScenarios["false-positive"];
---

<div data-locale={locale} class="threat-simulator-wrap not-prose my-8">
  <div class="threat-simulator-card">
    <header class="simulator-header">
      <div class="simulator-title-group">
        <span class="simulator-badge">INTERACTIVE EXPERIMENT</span>
        <h3 class="simulator-title">{t("AI 审计中的信任边界推演模拟器")}</h3>
      </div>
      <p class="simulator-subtitle">
        {t("切换场景，直观观察不同威胁假设下，数据流到底是如何在系统信任边界处被阻断或致命穿透的。")}
      </p>
    </header>

    <div class="scenario-tabs" role="tablist" aria-label={t("推演场景选择")}>
      {
        SCENARIO_TABS.map((tab, index) => (
          <button
            type="button"
            class:list={["scenario-tab", { active: index === 0 }]}
            role="tab"
            aria-selected={index === 0 ? "true" : "false"}
            data-scenario={tab.id}
            id={tab.domId}
          >
            <span class="tab-indicator" />
            <span class="tab-label">{t(tab.labelKey)}</span>
            <span class={`tab-tag ${tab.tagClass}`}>{t(tab.tagKey)}</span>
          </button>
        ))
      }
    </div>

    <div class="topology-stage" id="topology-stage" data-mode="false-positive">
      <section class="zone zone-untrusted" aria-label={t("非受信区")}>
        <div class="zone-label">
          <span class="zone-icon">⚠️</span>
          <span>{t("UNTRUSTED ZONE · 外部非受信攻击面")}</span>
        </div>

        <div class="nodes-row">
          <div class="sim-node node-attacker" id="node-attacker">
            <div class="node-badge">ATTACKER</div>
            <div class="node-title">{t("远程未认证攻击者")}</div>
            <div class="node-detail" id="attacker-payload" data-sim-field="attackerPayload">
              {initial.attackerPayload}
            </div>
          </div>

          <div class="sim-flow-arrow" id="flow-1" aria-hidden="true">
            <span class="pulse-beam"></span>
            <span class="flow-label" id="flow-label-1">HTTP Request</span>
          </div>

          <div class="sim-node node-input" id="node-input">
            <div class="node-badge">ENTRY POINT</div>
            <div class="node-title" id="input-title" data-sim-field="inputTitle">{initial.inputTitle}</div>
            <div class="node-detail font-mono" id="input-detail" data-sim-field="inputDetail">
              {initial.inputDetail}
            </div>
          </div>
        </div>
      </section>

      <div
        class={`trust-boundary-line boundary-${initial.boundaryClass}`}
        id="trust-boundary"
        aria-label={t("系统信任边界")}
      >
        <div class="boundary-glow"></div>
        <div class="boundary-label-pill" id="boundary-pill">
          <span class="status-dot" id="boundary-dot"></span>
          <span class="boundary-text" id="boundary-text" data-sim-field="boundaryText">{initial.boundaryText}</span>
        </div>
      </div>

      <section class="zone zone-trusted" aria-label={t("受信区与执行环境")}>
        <div class="zone-label">
          <span class="zone-icon">🛡️</span>
          <span>{t("TRUSTED ZONE · 内部受信执行环境")}</span>
        </div>

        <div class="nodes-row">
          <div class="sim-node node-source" id="node-source">
            <div class="node-badge">DATA SOURCE</div>
            <div class="node-title" id="source-title" data-sim-field="sourceTitle">{initial.sourceTitle}</div>
            <div class="node-detail font-mono" id="source-detail" data-sim-field="sourceDetail">
              {initial.sourceDetail}
            </div>
          </div>

          <div class="sim-flow-arrow" id="flow-2" aria-hidden="true">
            <span class="pulse-beam"></span>
            <span class="flow-label" id="flow-label-2">Internal Flow</span>
          </div>

          <div class="sim-node node-sink" id="node-sink">
            <div class="node-badge">DANGEROUS SINK</div>
            <div class="node-title" id="sink-title" data-sim-field="sinkTitle">{initial.sinkTitle}</div>
            <div class="node-detail font-mono" id="sink-detail" data-sim-field="sinkDetail">{initial.sinkDetail}</div>
          </div>
        </div>
      </section>
    </div>

    <div class="verdict-grid">
      <div class="verdict-box box-llm">
        <div class="box-header">
          <span class="box-tag">{t("LLM 纯语法/AST 视角")}</span>
          <span class="box-status" id="llm-status-badge" data-sim-field="llmBadge">{initial.llmBadge}</span>
        </div>
        <div class="box-body">
          <p class="box-headline" id="llm-headline" data-sim-field="llmHeadline">{initial.llmHeadline}</p>
          <p class="box-desc" id="llm-desc" data-sim-field="llmDesc">{initial.llmDesc}</p>
        </div>
      </div>

      <div class="verdict-box box-reality">
        <div class="box-header">
          <span class="box-tag">{t("威胁建模与实战研判")}</span>
          <span class="box-status" id="reality-status-badge" data-sim-field="realityBadge">{initial.realityBadge}</span>
        </div>
        <div class="box-body">
          <p class="box-headline" id="reality-headline" data-sim-field="realityHeadline">{initial.realityHeadline}</p>
          <p class="box-desc" id="reality-desc" data-sim-field="realityDesc">{initial.realityDesc}</p>
        </div>
      </div>
    </div>
  </div>
  <script is:inline type="application/json" data-sim-scenarios set:html={serializeJsonLd(translatedScenarios)} />
</div>

<script>
  import { onAstroPage } from "@/scripts/astro-lifecycle";

  interface ClientScenario {
    boundaryClass: string;
    [key: string]: string;
  }

  onAstroPage((signal) => {
    const wraps = document.querySelectorAll<HTMLElement>(".threat-simulator-wrap");
    for (const wrap of wraps) {
      const stage = wrap.querySelector<HTMLElement>("#topology-stage");
      const jsonEl = wrap.querySelector<HTMLScriptElement>("script[data-sim-scenarios]");
      const boundaryLine = wrap.querySelector<HTMLElement>("#trust-boundary");
      if (!stage || !jsonEl?.textContent) continue;

      let scenarios: Record<string, ClientScenario>;
      try {
        scenarios = JSON.parse(jsonEl.textContent) as Record<string, ClientScenario>;
      } catch {
        continue;
      }

      const tabs = wrap.querySelectorAll<HTMLButtonElement>(".scenario-tab");
      const fields = wrap.querySelectorAll<HTMLElement>("[data-sim-field]");

      const applyScenario = (id: string) => {
        const data = Object.hasOwn(scenarios, id) ? scenarios[id] : undefined;
        if (!data) return;

        for (const el of fields) {
          const key = el.dataset.simField;
          if (key && typeof data[key] === "string") {
            el.textContent = data[key];
          }
        }
        if (boundaryLine) {
          boundaryLine.className = `trust-boundary-line boundary-${data.boundaryClass}`;
        }
        stage.dataset.mode = id;
      };

      tabs.forEach((tab) => {
        tab.addEventListener(
          "click",
          () => {
            tabs.forEach((other) => {
              const active = other === tab;
              other.classList.toggle("active", active);
              other.setAttribute("aria-selected", String(active));
            });
            if (tab.dataset.scenario) applyScenario(tab.dataset.scenario);
          },
          { signal },
        );
      });
    }
  });
</script>
