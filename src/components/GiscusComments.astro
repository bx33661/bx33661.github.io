---
import { ENABLE_COMMENTS, GISCUS_CATEGORY, GISCUS_CATEGORY_ID, GISCUS_REPO, GISCUS_REPO_ID } from "@/config/env";
import { SITE } from "@/config.ts";
import { localeFromPath } from "@/i18n";

const locale = localeFromPath(Astro.url.pathname);
const isEnglish = locale === "en";

const requiredConfig = {
  repo: GISCUS_REPO,
  repoId: GISCUS_REPO_ID,
  category: GISCUS_CATEGORY,
  categoryId: GISCUS_CATEGORY_ID,
} as const;

const missingConfig = Object.entries(requiredConfig)
  .filter(([, value]) => !value)
  .map(([key]) => key);

const isConfigured = missingConfig.length === 0;
const shouldRenderComments = ENABLE_COMMENTS && isConfigured;
const showDevNotice = ENABLE_COMMENTS && !isConfigured && import.meta.env.DEV;
const giscusLang = isEnglish ? "en" : SITE.lang;
---

{
  shouldRenderComments && (
    <section id="comments" class="comments-panel mt-10 scroll-mt-24">
      <div class="mb-4 flex items-center gap-3" aria-hidden="true">
        <div class="from-accent/20 via-border/30 h-px flex-1 bg-linear-to-r to-transparent" />
        <span class="font-cartograph text-accent/35 text-[10px] tracking-widest uppercase select-none">
          // comments
        </span>
        <div class="via-border/30 to-accent/20 h-px flex-1 bg-linear-to-r from-transparent" />
      </div>

      <div class="comments-shell border-border/20 bg-muted/10 rounded-3xl border px-4 py-5 shadow-sm shadow-black/5 backdrop-blur-sm sm:px-6">
        <div class="mb-4 flex items-center justify-between gap-3">
          <div>
            <h2 class="text-lg font-semibold tracking-tight">{isEnglish ? "Comments" : "评论区"}</h2>
            <p class="text-foreground/60 mt-1 text-sm">
              {isEnglish
                ? "Powered by GitHub Discussions. Leave a comment below."
                : "使用 GitHub Discussions 驱动，欢迎留言交流。"}
            </p>
          </div>
        </div>

        <div
          data-giscus-host
          data-repo={GISCUS_REPO}
          data-repo-id={GISCUS_REPO_ID}
          data-category={GISCUS_CATEGORY}
          data-category-id={GISCUS_CATEGORY_ID}
          data-mapping="pathname"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="top"
          data-lang={giscusLang}
          data-loading="lazy"
        />
      </div>
    </section>
  )
}

{
  showDevNotice && (
    <section class="comments-panel mt-10">
      <div class="text-foreground/70 rounded-3xl border border-amber-500/20 bg-amber-500/8 px-4 py-4 text-sm sm:px-6">
        <p class="text-foreground/80 font-medium">
          {isEnglish ? "Giscus is enabled, but its configuration is incomplete." : "giscus 已开启，但配置还不完整。"}
        </p>
        <p class="mt-1">
          {isEnglish ? "Missing environment variables:" : "缺少这些环境变量："}
          <span class="font-cartograph text-xs text-amber-700 dark:text-amber-300">{missingConfig.join(", ")}</span>
        </p>
      </div>
    </section>
  )
}

<script>
  import "@/scripts/giscus-comments";
</script>

<style>
  .comments-shell {
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--muted) 18%, transparent),
        color-mix(in srgb, var(--background) 84%, transparent)
      ),
      radial-gradient(circle at top right, color-mix(in srgb, var(--accent) 10%, transparent), transparent 32%);
  }

  .comments-panel :global(.giscus) {
    width: 100%;
  }

  .comments-panel :global(.giscus-frame) {
    width: 100%;
  }
</style>
