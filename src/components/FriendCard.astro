---
type Props = {
  url: string;
  name: string;
  description: string;
  avatar?: string;
  host: string;
  fallback: string;
  index: number;
  isOrg?: boolean;
  kind?: string;
  tags?: string[];
};

const {
  url,
  name,
  description,
  avatar,
  host,
  fallback,
  index,
  isOrg = false,
  kind = "PERSONAL BLOG",
  tags = [],
} = Astro.props;
---

<a
  class:list={["fc", { "fc--org": isOrg }]}
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`访问 ${name}`}
  style={`--i:${index}`}
>
  <div class="fc-back" aria-hidden="true">
    <div class="fc-avatar-area">
      <span class="fc-avatar-fb">{fallback}</span>
      {
        avatar && (
          <img
            class="fc-avatar"
            src={avatar}
            alt=""
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
          />
        )
      }
    </div>
  </div>
  <div class="fc-front">
    <div class="fc-body">
      <div class="fc-meta"><span class="fc-kind">{kind}</span><span class="fc-index">{String(index + 1).padStart(2, '0')}</span></div>
      <h3 class="fc-name">{name}</h3>
      <p class="fc-desc">{description}</p>
      {tags.length > 0 && <div class="fc-tag-row" aria-label="站点标签">{tags.slice(0, 3).map((tag) => <span class="fc-tag">{tag}</span>)}</div>}
    </div>
    <div class="fc-foot">
      <span class="fc-host-pill">
        <img
          class="fc-favicon"
          src={`https://www.google.com/s2/favicons?domain=${host}&sz=32`}
          alt=""
          width="14"
          height="14"
          loading="lazy"
        />
        {host}
      </span>
      <span class="fc-arrow" aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
          <path
            d="M3.5 8.5L8.5 3.5M8.5 3.5H4.5M8.5 3.5V7.5"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </span>
    </div>
  </div>
</a>

<script>
  document.querySelectorAll<HTMLImageElement>(".fc-avatar").forEach((image) => {
    const showFallback = () => image.classList.add("fc-avatar--failed");
    if (image.complete && image.naturalWidth === 0) showFallback();
    else image.addEventListener("error", showFallback, { once: true });
  });
</script>
