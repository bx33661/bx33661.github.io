---
import "@pagefind/default-ui/css/ui.css";
import "@/styles/search-modal.css";
---

<dialog
  id="search-modal"
  class="search-dialog"
  aria-labelledby="search-dialog-title"
>
  <button
    class="search-backdrop"
    type="button"
    tabindex="-1"
    aria-label="关闭搜索"
    data-search-close></button>
  <div class="search-dialog-card">
    <header class="search-dialog-head">
      <div>
        <p class="search-dialog-kicker">SEARCH / QUICK FIND</p>
        <h2 id="search-dialog-title">站内搜索</h2>
      </div>
      <button
        class="search-dialog-close"
        type="button"
        aria-label="关闭搜索"
        data-search-close
      >
        <span aria-hidden="true">×</span>
      </button>
    </header>

    <div class="search-dialog-body">
      <div id="modal-pagefind-search"></div>
      <div class="search-suggestions" data-search-suggestions>
        <span>试试搜索</span>
        <button type="button" data-search-suggestion="CTF">CTF</button>
        <button type="button" data-search-suggestion="Web">Web</button>
        <button type="button" data-search-suggestion="安全审计">安全审计</button
        >
      </div>
    </div>

    <footer class="search-dialog-foot">
      <span
        ><kbd>↑</kbd><kbd>↓</kbd> 选择 <kbd>↵</kbd> 打开 <kbd>Esc</kbd> 关闭</span
      >
      <a href="/search/">前往完整搜索 <span aria-hidden="true">↗</span></a>
    </footer>
  </div>
</dialog>

<script src="../scripts/search-modal.ts"></script>
