---
import "@pagefind/default-ui/css/ui.css";
import "@/styles/search-modal.css";
---

<div
  id="search-modal"
  class="search-dialog"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-dialog-title"
  hidden
>
  <button
    class="search-backdrop"
    type="button"
    tabindex="-1"
    aria-label="关闭搜索"
    data-search-close></button>
  <div class="search-dialog-card">
    <header class="search-dialog-head">
      <div>
        <p class="search-dialog-kicker">SEARCH / QUICK FIND</p>
        <h2 id="search-dialog-title">站内搜索</h2>
      </div>
      <button
        class="search-dialog-close"
        type="button"
        aria-label="关闭搜索"
        data-search-close
      >
        <span aria-hidden="true">×</span>
      </button>
    </header>

    <div class="search-dialog-body">
      <div id="modal-pagefind-search"></div>
      <div class="search-suggestions" data-search-suggestions>
        <span>试试搜索</span>
        <button type="button" data-search-suggestion="CTF">CTF</button>
        <button type="button" data-search-suggestion="Web">Web</button>
        <button type="button" data-search-suggestion="安全审计">安全审计</button
        >
      </div>
    </div>

    <footer class="search-dialog-foot">
      <span
        ><kbd>↑</kbd><kbd>↓</kbd> 选择 <kbd>↵</kbd> 打开 <kbd>Esc</kbd> 关闭</span
      >
      <a href="/search/">前往完整搜索 <span aria-hidden="true">↗</span></a>
    </footer>
  </div>
</div>

<script>
  import { mountDevSearch } from "@/utils/devSearch";
  import { createPagefindUI } from "@/utils/pagefind";

  let cleanup: AbortController | undefined;
  let previousFocus: HTMLElement | null = null;
  let previousOverflow = "";

  function setupSearchModal() {
    cleanup?.abort();
    const controller = new AbortController();
    cleanup = controller;
    const { signal } = controller;
    const modal = document.querySelector<HTMLElement>("#search-modal");
    const mount = modal?.querySelector<HTMLElement>("#modal-pagefind-search");
    if (!modal || !mount) return;

    let loading: Promise<void> | undefined;
    const suggestions = modal.querySelector<HTMLElement>(
      "[data-search-suggestions]",
    );
    const getInput = () =>
      modal.querySelector<HTMLInputElement>(
        ".pagefind-ui__search-input, .search-fallback-input",
      );

    async function loadSearch() {
      if (loading) return loading;
      loading = (async () => {
        if (import.meta.env.DEV) {
          await mountDevSearch(mount!, { limit: 7 });
        } else {
          try {
            await createPagefindUI({
              element: "#modal-pagefind-search",
            });
          } catch {
            mount!.textContent = "搜索暂时不可用，请前往完整搜索页重试。";
          }
        }
        if (!modal!.hidden) getInput()?.focus();
      })();
      return loading;
    }

    function open() {
      if (!modal || !modal.hidden) return;
      previousFocus = document.activeElement as HTMLElement | null;
      previousOverflow = document.body.style.overflow;
      modal.hidden = false;
      document.body.style.overflow = "hidden";
      void loadSearch();
      getInput()?.focus();
    }

    function close() {
      if (!modal || modal.hidden) return;
      modal.hidden = true;
      document.body.style.overflow = previousOverflow;
      previousFocus?.focus();
    }

    document
      .querySelectorAll<HTMLElement>("[data-search-trigger]")
      .forEach((trigger) => {
        trigger.addEventListener(
          "click",
          (event) => {
            event.preventDefault();
            open();
          },
          { signal },
        );
      });

    modal
      .querySelectorAll<HTMLElement>("[data-search-close]")
      .forEach((button) => {
        button.addEventListener("click", close, { signal });
      });

    modal
      .querySelectorAll<HTMLButtonElement>("[data-search-suggestion]")
      .forEach((button) => {
        button.addEventListener(
          "click",
          () => {
            const input = getInput();
            if (!input) return;
            input.value = button.dataset.searchSuggestion ?? "";
            input.dispatchEvent(new Event("input", { bubbles: true }));
            input.focus();
          },
          { signal },
        );
      });

    modal.addEventListener(
      "input",
      () => {
        suggestions?.classList.toggle(
          "is-hidden",
          Boolean(getInput()?.value.trim()),
        );
      },
      { signal },
    );

    modal.addEventListener(
      "click",
      (event) => {
        if (
          (event.target as HTMLElement).closest(
            ".pagefind-ui__result-link, .search-fallback-link",
          )
        ) {
          close();
        }
      },
      { signal },
    );

    modal.addEventListener(
      "keydown",
      (event: KeyboardEvent) => {
        const links = Array.from(
          modal.querySelectorAll<HTMLAnchorElement>(
            ".pagefind-ui__result-link, .search-fallback-link",
          ),
        );
        const index = links.indexOf(
          document.activeElement as HTMLAnchorElement,
        );
        if (event.key === "ArrowDown" && links.length) {
          event.preventDefault();
          links[Math.min(index + 1, links.length - 1)].focus();
        } else if (event.key === "ArrowUp" && index >= 0) {
          event.preventDefault();
          if (index === 0) getInput()?.focus();
          else links[index - 1].focus();
        } else if (event.key === "Tab") {
          const focusable = Array.from(
            modal.querySelectorAll<HTMLElement>(
              "input:not([disabled]), button:not([disabled]), a[href]",
            ),
          ).filter((element) => element.getClientRects().length > 0);
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last?.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first?.focus();
          }
        }
      },
      { signal },
    );

    document.addEventListener(
      "keydown",
      (event: KeyboardEvent) => {
        if (
          (event.metaKey || event.ctrlKey) &&
          event.key.toLowerCase() === "k"
        ) {
          event.preventDefault();
          modal.hidden ? open() : close();
        } else if (event.key === "Escape" && !modal.hidden) {
          event.preventDefault();
          close();
        }
      },
      { signal },
    );
  }

  document.addEventListener("astro:page-load", setupSearchModal);
</script>
