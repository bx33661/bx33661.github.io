---
import "@pagefind/default-ui/css/ui.css";
import "@/styles/search-modal.css";
import { localeFromPath, localizedPath } from "@/i18n";

const locale = localeFromPath(Astro.url.pathname);
const copy =
  locale === "en"
    ? {
        close: "Close search",
        title: "Search English content",
        trySearching: "Try searching",
        topic: "Security",
        select: "Select",
        open: "Open",
        closeHint: "Close",
        fullSearch: "Full search",
      }
    : {
        close: "关闭搜索",
        title: "站内搜索",
        trySearching: "试试搜索",
        topic: "安全审计",
        select: "选择",
        open: "打开",
        closeHint: "关闭",
        fullSearch: "前往完整搜索",
      };
---

<dialog id="search-modal" class="search-dialog" aria-labelledby="search-dialog-title">
  <button class="search-backdrop" type="button" tabindex="-1" aria-label={copy.close} data-search-close></button>
  <div class="search-dialog-card">
    <header class="search-dialog-head">
      <div>
        <p class="search-dialog-kicker">SEARCH / QUICK FIND</p>
        <h2 id="search-dialog-title">{copy.title}</h2>
      </div>
      <button class="search-dialog-close" type="button" aria-label={copy.close} data-search-close>
        <span aria-hidden="true">×</span>
      </button>
    </header>

    <div class="search-dialog-body">
      <div id="modal-pagefind-search" class="pagefind-surface"></div>
      <div class="search-suggestions" data-search-suggestions>
        <span>{copy.trySearching}</span>
        <button type="button" data-search-suggestion="CTF">CTF</button>
        <button type="button" data-search-suggestion="Web">Web</button>
        <button type="button" data-search-suggestion={copy.topic}>{copy.topic}</button>
      </div>
    </div>

    <footer class="search-dialog-foot">
      <span>
        <kbd>↑</kbd><kbd>↓</kbd>
        {copy.select}
        <kbd>↵</kbd>
        {copy.open}
        <kbd>Esc</kbd>
        {copy.closeHint}
      </span>
      <a href={localizedPath("/search/", locale)}>
        {copy.fullSearch}
        <span aria-hidden="true">↗</span>
      </a>
    </footer>
  </div>
</dialog>

<script src="../scripts/search-modal.ts"></script>
