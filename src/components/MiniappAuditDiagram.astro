---
import { articleCopy } from "@/i18n/articles";
import { localeFromPath } from "@/i18n";
import {
  AUDIT_AGENTS,
  BINARY_LAYERS,
  CACHE_PATH_SEGMENTS,
  DIAGRAM_FIGURES,
  PACKAGE_TYPES,
  VERSION_CARDS,
} from "@/data/miniapp-audit";
import "@/styles/miniapp-audit-diagram.css";

interface Props {
  locale?: "en" | "zh-CN";
  variant: "cache" | "package" | "versions" | "agents";
}

const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const t = (text: string) => articleCopy(locale, text);
const { variant } = Astro.props;
const figure = DIAGRAM_FIGURES[variant];
---

<figure class="mad-figure not-prose" aria-label={t(figure.ariaLabelKey)}>
  <figcaption>
    <span class="mad-eyebrow">{figure.eyebrow}</span>
    <strong>{t(figure.titleKey)}</strong>
  </figcaption>

  {
    variant === "cache" && (
      <>
        <div class="mad-path" aria-label={t("缓存目录路径")}>
          {CACHE_PATH_SEGMENTS.map((seg) => (
            <span>{seg.translate ? t(seg.text) : seg.text}</span>
          ))}
        </div>
        <div class="mad-package-grid">
          {PACKAGE_TYPES.map((item) => (
            <div class={`mad-package mad-${item.tone}`}>
              <div class="mad-package-top">
                <span class="mad-package-kind">{t(item.kindKey)}</span>
                <span class="mad-package-dot" aria-hidden="true" />
              </div>
              <code>{item.name}</code>
              <p>{t(item.detailKey)}</p>
            </div>
          ))}
        </div>
      </>
    )
  }

  {
    variant === "package" && (
      <div class="mad-layer-stack">
        {BINARY_LAYERS.map((layer, index) => (
          <div class="mad-layer">
            <span class="mad-layer-num">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <strong>{t(layer.nameKey)}</strong>
              <span>{t(layer.detailKey)}</span>
            </div>
            <code>{layer.english}</code>
          </div>
        ))}
      </div>
    )
  }

  {
    variant === "versions" && (
      <>
        <div class="mad-version-root">
          <code>packages / wx1234567890abcdef /</code>
          <span>APP ID</span>
        </div>
        <div class="mad-version-grid">
          {VERSION_CARDS.map((card) => (
            <div class="mad-version">
              <div class="mad-version-head">
                <strong>{card.version} /</strong>
                <span>{t(card.labelKey)}</span>
              </div>
              {card.files.map((file) => (
                <code>
                  {file.name} <em>{t(file.tagKey)}</em>
                </code>
              ))}
            </div>
          ))}
        </div>
      </>
    )
  }

  {
    variant === "agents" && (
      <div class="mad-agent-grid">
        {AUDIT_AGENTS.map(([name, detailKey], index) => (
          <div class="mad-agent">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <code>{name}</code>
              <p>{t(detailKey)}</p>
            </div>
          </div>
        ))}
      </div>
    )
  }

  <p class="mad-footnote">{t(figure.footnoteKey)}</p>
</figure>
