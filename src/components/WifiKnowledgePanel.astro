---
import { localeFromPath } from "@/i18n";
import { wifiCopy } from "@/i18n/wifi";
import {
  SPECTRUM_MARKS,
  VERDICT_LABELS,
  WIFI_PANEL_LIST_CONFIGS,
  type WifiPanelListConfig,
  type WifiPanelListVariant,
  type WifiPanelVariant,
} from "@/data/wifi-diagrams";
import "@/styles/wifi-article.css";

interface Props {
  variant: WifiPanelVariant;
  label: string;
  rows: string[][];
}

const { variant, label, rows } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const isEnglish = locale === "en";
const t = (text: string) => wifiCopy(isEnglish, text);
const formatIndex = (i: number) => String(i + 1).padStart(2, "0");

const listConfig: WifiPanelListConfig | undefined =
  variant in WIFI_PANEL_LIST_CONFIGS ? WIFI_PANEL_LIST_CONFIGS[variant as WifiPanelListVariant] : undefined;

function getListMarker(index: number): string {
  switch (variant) {
    case "spectrum":
      return SPECTRUM_MARKS[index] ?? "";
    case "verdict":
      return t(VERDICT_LABELS[index] ?? "");
    case "hypotheses":
      return `H${formatIndex(index)}`;
    default:
      return formatIndex(index);
  }
}

const ListTag = listConfig?.tag ?? "ol";
---

<section class:list={["wifi-knowledge", "not-prose", `wk-${variant}`]} data-wifi-locale={locale} aria-label={label}>
  <div class="wk-caption">
    <span class="wk-caption-line"></span>
    <strong>{label}</strong>
  </div>
  {
    variant === "selection" ? (
      <div class="wk-checklist">
        <p class="wk-hint">{t("六项独立验收 · 展开查看常见误判")}</p>
        {rows.map(([title, detail, note], i) => (
          <details class="wk-check" open={i === 0}>
            <summary>
              <span class="wk-number">{formatIndex(i)}</span>
              <span class="wk-check-copy">
                <strong>{title}</strong>
                <span>{detail}</span>
              </span>
              <span class="wk-toggle" aria-hidden="true" />
            </summary>
            <p class="wk-caution">
              <span>{t("避免误判")}</span>
              {note}
            </p>
          </details>
        ))}
      </div>
    ) : variant === "exchange" ? (
      <dl class="wk-messages">
        {rows.map(([title, detail, note], i) => (
          <div class:list={["wk-message", { "wk-reverse": i % 2 === 1 }]}>
            <dt>{title}</dt>
            <dd>
              <span class="wk-direction">{i % 2 === 0 ? "AP → STA" : "STA → AP"}</span>
              <strong>{detail.replace(/^(AP → STA|STA → AP)[，,]\s*/, "")}</strong>
              <span class="wk-footnote">{note}</span>
            </dd>
          </div>
        ))}
      </dl>
    ) : listConfig ? (
      <ListTag class={listConfig.listClass}>
        {rows.map(([title, detail, note], i) => {
          const body = (
            <>
              <strong>{title}</strong>
              <p class={listConfig.detailClass}>
                {listConfig.detailLabel && <span class="wk-inline-label">{t(listConfig.detailLabel)}</span>}
                {detail}
              </p>
              {listConfig.hasFootnote && (
                <p class="wk-footnote">
                  {listConfig.footnotePrefix && t(listConfig.footnotePrefix)}
                  {note}
                </p>
              )}
            </>
          );
          return (
            <li>
              <span class={listConfig.markerClass} aria-hidden={listConfig.markerHidden ? "true" : undefined}>
                {getListMarker(i)}
              </span>
              {listConfig.wrapContent ? <div>{body}</div> : body}
            </li>
          );
        })}
      </ListTag>
    ) : (
      <dl class={variant === "glossary" ? "wk-definitions" : "wk-notes"}>
        {rows.map(([title, detail, note], i) => {
          const num = formatIndex(i);
          return (
            <div>
              {variant === "glossary" ? (
                <>
                  <span class="wk-number" aria-hidden="true">
                    {num}
                  </span>
                  <dt>{title}</dt>
                </>
              ) : (
                <dt>
                  <span class="wk-number">{num}</span>
                  {title}
                </dt>
              )}
              <dd>
                {detail}
                <span class="wk-footnote">
                  {variant === "glossary" && t("核对：")}
                  {note}
                </span>
              </dd>
            </div>
          );
        })}
      </dl>
    )
  }
</section>
