---
import { localeFromPath } from "@/i18n";
import { ui } from "@/i18n/ui";
const locale = localeFromPath(Astro.url.pathname);
const t = ui(locale);
---

<dialog id="article-lightbox" class="article-lightbox" aria-label={t.imageViewer} data-pagefind-ignore>
  <button type="button" data-image-close aria-label={t.closeImage}>
    <span aria-hidden="true">×</span>
  </button>
  <img data-image-full alt="" />
  <div class="article-lightbox-bar" data-image-bar hidden>
    <button type="button" class="article-lightbox-nav" data-image-prev aria-label={t.previousImage}>
      <span aria-hidden="true">←</span>
    </button>
    <span class="article-lightbox-counter" data-image-counter></span>
    <p class="article-lightbox-note" data-image-note></p>
    <button
      type="button"
      class="article-lightbox-zoom"
      data-image-zoom
      data-label-in={t.zoomInImage}
      data-label-out={t.zoomOutImage}
      aria-label={t.zoomInImage}
      title={t.zoomInImage}
    >
      1×
    </button>
    <button type="button" class="article-lightbox-nav" data-image-next aria-label={t.nextImage}>
      <span aria-hidden="true">→</span>
    </button>
  </div>
</dialog>
