---
import { localeFromPath } from "@/i18n";
import type { CollectionEntry } from "astro:content";
import IconEdit from "@/assets/icons/IconEdit.svg";
import { SITE } from "@/config.ts";

type Props = {
  hideEditPost?: CollectionEntry<"blog">["data"]["hideEditPost"];
  class?: string;
  post: CollectionEntry<"blog">;
};

const { hideEditPost, post, class: className = "" } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const label = locale === "zh-CN" ? SITE.editPost.text.zh : SITE.editPost.text.en;

const href = `${SITE.editPost.url}${post.filePath}`;
const showEditPost = SITE.editPost.enabled && !hideEditPost && SITE.editPost.url.trim() !== "";
---

{
  showEditPost && (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class:list={["hover:text-accent flex justify-baseline gap-1.5 opacity-80", className]}
    >
      <IconEdit class="inline-block" />
      <span>{label}</span>
    </a>
  )
}
