---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import EntryRow from "@/components/EntryRow.astro";
import { SITE } from "@/config.ts";
import { getAllNotesWithSlugs } from "@/utils/notes";

import { localeFromPath, localizedPath } from "@/i18n";
import { ui } from "@/i18n/ui";
import ContentEmpty from "@/components/ContentEmpty.astro";
const locale = localeFromPath(Astro.url.pathname);
const t = ui(locale);
const notes = await getAllNotesWithSlugs(locale);
const categories = new Map<string, number>();
const tags = new Map<string, number>();

for (const { note } of notes) {
  const category = note.data.category || t.uncategorized;
  categories.set(category, (categories.get(category) || 0) + 1);
  for (const tag of note.data.tags || []) {
    tags.set(tag, (tags.get(tag) || 0) + 1);
  }
}

const categoryEntries = Array.from(categories.entries()).sort((a, b) => b[1] - a[1]);
---

<Layout
  title={`Notes | ${SITE.title}`}
  description={t.notesDescription}
  noindex={!notes.length}
  canonicalURL={Astro.url.toString()}
>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-10">
    <header class="page-head">
      <p class="page-kicker">NOTES / INDEX</p>
      <h1>{t.notes}</h1>
      <p class="page-description">{t.notesLead}</p>
      <p class="page-meta">
        {t.notesCount(notes.length, categories.size, tags.size)}
      </p>
    </header>

    <section class="content-section">
      <h2>{t.categories}</h2>
      {
        categoryEntries.length === 0 ? (
          <p class="text-foreground/70 mt-2">{t.noCategories}</p>
        ) : (
          <ul class="category-chips" role="group" aria-label={t.categories}>
            <li>
              <button type="button" class="category-chip" data-category-filter="all" aria-pressed="true">
                {t.allCategories} <span class="category-chip-count">{notes.length}</span>
              </button>
            </li>
            {categoryEntries.map(([category, count]) => (
              <li>
                <button type="button" class="category-chip" data-category-filter={category} aria-pressed="false">
                  {category} <span class="category-chip-count">{count}</span>
                </button>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section class="content-section">
      <div class="section-head">
        <h2>{t.recentUpdates}</h2>
        <a href={localizedPath("/notes/list/", locale)}>{t.allNotes} →</a>
      </div>
      {!notes.length && <ContentEmpty kind="notes" />}
      <ul class="entry-list" data-notes-index-list>
        {
          notes
            .slice(0, 10)
            .map(({ note, slug }) => (
              <EntryRow
                href={localizedPath(`/notes/${slug}/`, locale)}
                title={note.data.title}
                description={note.data.description}
                date={note.data.date}
                category={note.data.category || t.uncategorized}
                heading="h3"
              />
            ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  import { onAstroPage } from "@/scripts/astro-lifecycle";

  onAstroPage((signal) => {
    const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-category-filter]")];
    const rows = [...document.querySelectorAll<HTMLElement>("[data-notes-index-list] > .entry-row")];
    if (!buttons.length || !rows.length) return;

    const applyFilter = (target: string) => {
      for (const btn of buttons) {
        btn.setAttribute("aria-pressed", String(btn.dataset.categoryFilter === target));
      }
      for (const row of rows) {
        row.hidden = target !== "all" && row.dataset.category !== target;
      }
    };

    for (const btn of buttons) {
      btn.addEventListener(
        "click",
        () => {
          const next = btn.dataset.categoryFilter ?? "all";
          const currentActive = btn.getAttribute("aria-pressed") === "true";
          applyFilter(next !== "all" && currentActive ? "all" : next);
        },
        { signal },
      );
    }
  });
</script>

<style>
  .page-head {
    padding: 0.4rem 0 1.6rem;
  }
  .page-kicker {
    margin: 0 0 0.45rem;
    color: var(--accent);
    font-family: var(--font-cartograph), ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.85rem, 3.5vw, 2.35rem);
    font-weight: 700;
    letter-spacing: -0.035em;
  }
  .page-description {
    margin: 0.55rem 0 0;
    color: color-mix(in srgb, var(--foreground) 68%, transparent);
    line-height: 1.7;
  }
  .page-meta {
    margin: 0.7rem 0 0;
    color: color-mix(in srgb, var(--foreground) 48%, transparent);
    font-size: 0.78rem;
  }
  .content-section {
    margin-top: 1.65rem;
    padding-top: 1.65rem;
    border-top: 1px solid color-mix(in srgb, var(--border) 28%, transparent);
  }
  .content-section h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }
  .section-head a {
    color: var(--accent);
    font-size: 0.78rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .section-head a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .category-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.55rem;
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
  }
  .category-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.32rem 0.75rem;
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    color: var(--foreground);
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      border-color 0.16s ease,
      color 0.16s ease,
      background-color 0.16s ease;
  }
  .category-chip-count {
    font-family: var(--font-cartograph), monospace;
    font-size: 0.72rem;
    color: var(--muted-foreground);
  }
  .category-chip:hover,
  .category-chip:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--accent) 7%, var(--surface));
    color: var(--accent);
  }
  .category-chip[aria-pressed="true"] {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--accent) 12%, var(--surface));
    color: var(--accent);
    font-weight: 600;
  }
  .category-chip[aria-pressed="true"] .category-chip-count {
    color: var(--accent);
  }
  :global(html[data-theme="dark"]) .page-meta {
    color: color-mix(in srgb, var(--foreground) 68%, transparent);
  }
</style>
