---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import EntryRow from "@/components/EntryRow.astro";
import { SITE } from "@/config.ts";
import { getAllNotesWithSlugs } from "@/utils/notes";

import { localeFromPath, localizedPath } from "@/i18n";
import { ui } from "@/i18n/ui";
import ContentEmpty from "@/components/ContentEmpty.astro";
const locale = localeFromPath(Astro.url.pathname);
const t = ui(locale);
const notes = await getAllNotesWithSlugs(locale);
const categories = new Map<string, number>();
const tags = new Map<string, number>();

for (const { note } of notes) {
  const category = note.data.category || t.uncategorized;
  categories.set(category, (categories.get(category) || 0) + 1);
  for (const tag of note.data.tags || []) {
    tags.set(tag, (tags.get(tag) || 0) + 1);
  }
}

const categoryEntries = Array.from(categories.entries()).sort(
  (a, b) => b[1] - a[1],
);
---

<Layout
  title={`Notes | ${SITE.title}`}
  description={t.notesDescription}
  noindex={!notes.length}
  canonicalURL={Astro.url.toString()}
>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-10">
    <header class="page-head">
      <p class="page-kicker">NOTES / INDEX</p>
      <h1>{t.notes}</h1>
      <p class="page-description">{t.notesLead}</p>
      <p class="page-meta">
        {t.notesCount(notes.length, categories.size, tags.size)}
      </p>
    </header>

    <section class="content-section">
      <h2>{t.categories}</h2>
      {
        categoryEntries.length === 0 ? (
          <p class="mt-2 text-foreground/70">{t.noCategories}</p>
        ) : (
          <ul class="mt-3 flex flex-wrap gap-2">
            {categoryEntries.map(([category, count]) => (
              <li class="rounded-full border border-border/30 px-3 py-1 text-sm">
                {category} ({count})
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section class="content-section">
      <div class="section-head">
        <h2>{t.recentUpdates}</h2>
        <a href={localizedPath("/notes/list/", locale)}>{t.allNotes} →</a>
      </div>
      {!notes.length && <ContentEmpty kind="notes" />}
      <ul class="entry-list">
        {
          notes
            .slice(0, 10)
            .map(({ note, slug }) => (
              <EntryRow
                href={localizedPath(`/notes/${slug}/`, locale)}
                title={note.data.title}
                description={note.data.description}
                date={note.data.date}
                category={note.data.category || t.uncategorized}
                heading="h3"
              />
            ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-head {
    padding: 0.4rem 0 1.6rem;
  }
  .page-kicker {
    margin: 0 0 0.45rem;
    color: var(--accent);
    font-family: var(--font-cartograph), ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.85rem, 3.5vw, 2.35rem);
    font-weight: 700;
    letter-spacing: -0.035em;
  }
  .page-description {
    margin: 0.55rem 0 0;
    color: color-mix(in srgb, var(--foreground) 68%, transparent);
    line-height: 1.7;
  }
  .page-meta {
    margin: 0.7rem 0 0;
    color: color-mix(in srgb, var(--foreground) 48%, transparent);
    font-size: 0.78rem;
  }
  .content-section {
    margin-top: 1.65rem;
    padding-top: 1.65rem;
    border-top: 1px solid color-mix(in srgb, var(--border) 28%, transparent);
  }
  .content-section h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }
  .section-head a {
    color: var(--accent);
    font-size: 0.78rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .section-head a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .entry-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  :global(html[data-theme="dark"]) .page-meta {
    color: color-mix(in srgb, var(--foreground) 68%, transparent);
  }
</style>
