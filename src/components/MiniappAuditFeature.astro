---
import { articleCopy } from "@/i18n/articles";
import { localeFromPath } from "@/i18n";
import { MINIAPP_STAGES, type MiniappStageSpec } from "@/data/miniapp-audit";
import { serializeJsonLd } from "@/utils/serializeJsonLd";
import "@/styles/miniapp-audit-feature.css";

interface Props {
  locale?: "en" | "zh-CN";
  variant: "overview" | "pipeline";
}

const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const t = (text: string) => articleCopy(locale, text);
const { variant } = Astro.props;

const stages = MINIAPP_STAGES.map((stage) => ({
  id: stage.id,
  label: t(stage.labelKey),
  code: stage.code,
  title: t(stage.titleKey),
  detail: t(stage.detailKey),
  artifact: stage.artifact,
}));

const stageMap: Record<MiniappStageSpec["id"], (typeof stages)[number]> = Object.fromEntries(
  stages.map((stage) => [stage.id, stage]),
) as Record<MiniappStageSpec["id"], (typeof stages)[number]>;
---

{
  variant === "overview" ? (
    <aside class="ma-feature ma-overview not-prose" aria-label={t("小程序自动化审计流程概览")}>
      <div class="ma-overview-copy">
        <div class="ma-kicker">
          <span class="ma-live-dot" aria-hidden="true" /> MINIAPP / AUDIT MAP
        </div>
        <strong>{t("从一个包，到一条可验证的证据链。")}</strong>
        <p>{t("先收齐材料，再还原代码；Agent 帮助整理线索，最终结论仍由请求、响应与源码共同支撑。")}</p>
        <div class="ma-legend">
          <span>PACKAGE</span>
          <span>CODE</span>
          <span>API</span>
          <span>EVIDENCE</span>
        </div>
      </div>
      <div class="ma-device" aria-hidden="true">
        <div class="ma-device-top">
          <span>WxLocated</span>
          <span>● ● ●</span>
        </div>
        <div class="ma-device-body">
          <span class="ma-device-caption">PACKAGE TREE</span>
          <div class="ma-tree-row ma-tree-root">
            <i />
            __APP__.wxapkg <b>MAIN</b>
          </div>
          <div class="ma-tree-row ma-tree-child">
            <i />
            packageOrder/ <b>SUB</b>
          </div>
          <div class="ma-tree-row ma-tree-child">
            <i />
            packageShop/ <b>SUB</b>
          </div>
          <div class="ma-device-flow">
            <span>{t("解包")}</span>
            <span>→</span>
            <span>{t("建模")}</span>
            <span>→</span>
            <span>{t("验证")}</span>
          </div>
        </div>
      </div>
    </aside>
  ) : (
    <section
      id="miniapp-audit-pipeline"
      data-locale={locale}
      class="ma-feature ma-pipeline not-prose"
      aria-labelledby="ma-pipeline-title"
      data-pagefind-ignore
    >
      <div class="ma-pipeline-head">
        <div>
          <span class="ma-kicker">INTERACTIVE / AUDIT PIPELINE</span>
          <div id="ma-pipeline-title" class="ma-pipeline-title" role="heading" aria-level="3">
            {t("把审计过程拆成五个可检查的阶段")}
          </div>
        </div>
        <span class="ma-pipeline-count" aria-hidden="true">
          01 — 05
        </span>
      </div>
      <p class="ma-pipeline-intro">{t("点击阶段，查看该阶段要回答的问题与应留下的材料。")}</p>
      <div class="ma-stage-list" role="group" aria-label={t("选择审计阶段")}>
        {stages.map((stage, index) => (
          <button type="button" data-ma-stage={stage.id} aria-pressed={index === 0 ? "true" : "false"}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            {stage.label}
          </button>
        ))}
      </div>
      <div class="ma-stage-detail" aria-live="polite">
        <div class="ma-stage-index" data-ma-code>
          {stages[0].code}
        </div>
        <div class="ma-stage-title" role="heading" aria-level="4" data-ma-title>
          {stages[0].title}
        </div>
        <p data-ma-detail>{stages[0].detail}</p>
        <div class="ma-artifact">
          <span>OUTPUT / EVIDENCE</span>
          <code data-ma-artifact>{stages[0].artifact}</code>
        </div>
      </div>
      <p class="ma-pipeline-foot">{t("每一步都可以停在“材料不足”；流程图不是自动确认漏洞的承诺。")}</p>
      <script is:inline type="application/json" data-ma-stages set:html={serializeJsonLd(stageMap)} />
    </section>
  )
}

<script>
  import { onAstroPage } from "@/scripts/astro-lifecycle";

  interface StagePayload {
    code: string;
    title: string;
    detail: string;
    artifact: string;
  }

  onAstroPage((signal) => {
    const root = document.querySelector<HTMLElement>("#miniapp-audit-pipeline");
    const jsonEl = root?.querySelector<HTMLScriptElement>("script[data-ma-stages]");
    if (!root || !jsonEl?.textContent) return;

    let stages: Record<string, StagePayload>;
    try {
      stages = JSON.parse(jsonEl.textContent) as Record<string, StagePayload>;
    } catch {
      return;
    }

    const buttons = root.querySelectorAll<HTMLButtonElement>("[data-ma-stage]");
    const slots = {
      code: root.querySelector<HTMLElement>("[data-ma-code]"),
      title: root.querySelector<HTMLElement>("[data-ma-title]"),
      detail: root.querySelector<HTMLElement>("[data-ma-detail]"),
      artifact: root.querySelector<HTMLElement>("[data-ma-artifact]"),
    };

    buttons.forEach((button) => {
      button.addEventListener(
        "click",
        () => {
          const id = button.dataset.maStage;
          const stage = id && Object.hasOwn(stages, id) ? stages[id] : undefined;
          if (!stage) return;
          if (slots.code) slots.code.textContent = stage.code;
          if (slots.title) slots.title.textContent = stage.title;
          if (slots.detail) slots.detail.textContent = stage.detail;
          if (slots.artifact) slots.artifact.textContent = stage.artifact;
          buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
        },
        { signal },
      );
    });
  });
</script>
