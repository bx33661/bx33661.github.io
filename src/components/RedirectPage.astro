---
import { SITE } from "@/config.ts";

interface Props {
  target: string;
  title: string;
  label?: string;
  lang?: "zh-CN" | "en";
}

const { target, title, label = target, lang = "zh-CN" } = Astro.props;
const canonical = new URL(target, Astro.site ?? SITE.website);
canonical.hash = "";
const canonicalUrl = canonical.toString();
const prefix = lang === "en" ? "Redirecting to " : "正在前往";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
  </head>
  <body>
    <p>{prefix}<a href={target}>{label}</a>…</p>
  </body>
</html>
