---
import { localeFromPath } from "@/i18n";
import { ui } from "@/i18n/ui";
const locale = localeFromPath(Astro.url.pathname);
const t = ui(locale);
import { SHARE_LINKS } from "@/constants";
import LinkButton from "./LinkButton.astro";

const URL = Astro.url;
---

{
  SHARE_LINKS.length > 0 && (
    <div class="flex shrink-0 flex-col items-center gap-2 sm:items-end">
      <span class="font-cartograph text-foreground/40 text-[10px] tracking-wider uppercase select-none">{t.share}</span>
      <div class="flex items-center gap-1">
        {SHARE_LINKS.map((social) => (
          <LinkButton
            href={`${social.href + URL}`}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn border-border/20 bg-muted/5 hover:border-accent/40 hover:bg-accent/10 hover:text-accent hover:shadow-accent/10 inline-flex size-8 items-center justify-center rounded-lg border transition-all duration-200 hover:shadow-sm"
            title={social.linkTitle}
          >
            <social.icon class="size-4 fill-transparent stroke-current stroke-2" />
            <span class="sr-only">{social.linkTitle}</span>
          </LinkButton>
        ))}
      </div>
    </div>
  )
}

<style>
  .share-btn {
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
</style>
