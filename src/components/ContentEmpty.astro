---
import { DEFAULT_LOCALE, localeFromPath, localizedPath } from "@/i18n";
import { ui } from "@/i18n/ui";

interface Props {
  kind: "posts" | "notes";
}
const { kind } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const t = ui(locale);
---

<p class="text-foreground/70 my-6 leading-relaxed" data-content-empty>
  {kind === "posts" ? t.emptyPosts : t.emptyNotes}
  {
    locale !== DEFAULT_LOCALE && (
      <a
        class="text-accent ml-2 underline underline-offset-4"
        href={localizedPath(kind === "posts" ? "/blog/" : "/notes/", DEFAULT_LOCALE)}
        lang={DEFAULT_LOCALE}
      >
        {t.originals} →
      </a>
    )
  }
</p>
