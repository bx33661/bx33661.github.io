---
import { localeFromPath } from "@/i18n";
import { wifiCopy } from "@/i18n/wifi";
import {
  DISCOVERY_MESSAGES,
  EVIDENCE_ROWS,
  FRAME_SEGMENTS,
  HARDWARE_NODES,
  KEY_EXCHANGE_STEPS,
  LAYER_NODES,
  WIFI_DIAGRAM_INFO,
  type WifiDiagramVariant,
} from "@/data/wifi-diagrams";
import "@/styles/wifi-article.css";

interface Props {
  variant: WifiDiagramVariant;
}

const { variant } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const isEnglish = locale === "en";
const t = (text: string) => wifiCopy(isEnglish, text);

const meta = WIFI_DIAGRAM_INFO[variant];
const number = meta.number;
const title = t(meta.title);
const note = t(meta.note);
const layouts = [false, true] as const;
---

<figure
  data-wifi-locale={locale}
  class={`wifi-figure wifi-${variant} not-prose`}
  aria-label={`${t("图")} ${number}: ${title}`}
>
  <div class="wifi-figure-heading">
    <span class="wifi-figure-index">FIG. {number}</span>
    <strong>{title}</strong>
    <span class="wifi-figure-kind">{variant === "evidence" ? "EVIDENCE MATRIX" : "SCHEMATIC"}</span>
  </div>
  {
    variant === "evidence" ? (
      <div class="wifi-matrix-wrap" tabindex="0" aria-label={t("连接状态与验收证据对照表，可横向滚动")}>
        <table class="wifi-matrix">
          <thead>
            <tr>
              <th>{t("观察层")}</th>
              <th>{t("状态变化")}</th>
              <th>{t("验收证据")}</th>
              <th>{t("结论边界")}</th>
            </tr>
          </thead>
          <tbody>
            {EVIDENCE_ROWS.map((row) => (
              <tr class:list={[{ "wifi-matrix-divider": row.divider }]}>
                <th>
                  <span class:list={["wifi-dot", { "wifi-dot-outline": row.outline }]} />
                  {t(row.layer)}
                </th>
                <td>{t(row.transition)}</td>
                <td>{row.evidence}</td>
                <td>{t(row.boundary)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      layouts.map((mobile) => {
        const w = mobile ? 320 : 720;
        const h = mobile ? meta.mobileHeight : meta.desktopHeight;
        const arrow = `wifi-arrow-${variant}-${mobile ? "m" : "d"}`;
        const apX = mobile ? 52 : 120;
        const staX = mobile ? 268 : 600;
        const apArrowX = mobile ? 56 : 124;
        const staArrowX = mobile ? 264 : 596;

        return (
          <svg
            class:list={["wifi-plot", mobile ? "wifi-plot-mobile" : "wifi-plot-desktop"]}
            viewBox={`0 0 ${w} ${h}`}
            role="img"
            aria-label={title}
          >
            <defs>
              <marker
                id={arrow}
                viewBox="0 0 10 10"
                refX="8"
                refY="5"
                markerWidth="6"
                markerHeight="6"
                orient="auto-start-reverse"
              >
                <path d="M 1 1 L 9 5 L 1 9" class="wifi-arrowhead" />
              </marker>
            </defs>

            {variant === "hardware" && (
              <>
                {HARDWARE_NODES.map((node, i) => {
                  const [x, y] = mobile ? node.mobile : node.desktop;
                  const boxWidth = mobile ? 240 : 200;
                  return (
                    <g>
                      <rect
                        x={x}
                        y={y}
                        width={boxWidth}
                        height="86"
                        class:list={["wifi-node", { "wifi-node-focus": node.focus }]}
                      />
                      <text x={x + boxWidth / 2} y={y + 32} class="wifi-label">
                        {t(node.label)}
                      </text>
                      <text x={x + boxWidth / 2} y={y + 59} class="wifi-code">
                        {node.translateCode ? t(node.code) : node.code}
                      </text>
                      {i < HARDWARE_NODES.length - 1 && (
                        <line
                          x1={mobile ? 160 : x + 200}
                          y1={mobile ? y + 86 : 103}
                          x2={mobile ? 160 : x + 232}
                          y2={mobile ? y + 120 : 103}
                          class="wifi-link"
                          marker-end={`url(#${arrow})`}
                        />
                      )}
                    </g>
                  );
                })}
                <text x={w / 2} y={mobile ? 405 : 198} class="wifi-emphasis">
                  {t("按驱动能力控制信道与模式")}
                </text>
                <line x1="20" x2={w - 20} y1={mobile ? 430 : 222} y2={mobile ? 430 : 222} class="wifi-rule" />
                <text x={w / 2} y={mobile ? 458 : 251} class="wifi-muted">
                  {t("对照：NAT / 桥接 → 虚拟以太网")}
                </text>
                <text x={w / 2} y={mobile ? 480 : 275} class="wifi-small">
                  {t("能上网 ≠ 已获得 802.11 射频接口")}
                </text>
              </>
            )}

            {(variant === "keys" || variant === "discovery") && (
              <>
                <text x={apX} y={variant === "keys" ? 32 : 36} class="wifi-label">
                  AP
                </text>
                <text x={staX} y={variant === "keys" ? 32 : 36} class="wifi-label">
                  STA
                </text>
                <text x={apX} y={variant === "keys" ? 57 : 59} class="wifi-small">
                  {t(variant === "keys" ? "认证端" : "接入点")}
                </text>
                <text x={staX} y={variant === "keys" ? 57 : 59} class="wifi-small">
                  {t(variant === "keys" ? "终端" : "无线终端")}
                </text>
                {[apX, staX].map((x) => (
                  <line x1={x} x2={x} y1="80" y2={variant === "keys" ? 468 : 330} class="wifi-lifeline" />
                ))}
              </>
            )}

            {variant === "keys" && (
              <>
                {KEY_EXCHANGE_STEPS.map((step) => (
                  <g>
                    <text x={w / 2} y={step.y - 16} class="wifi-code">
                      {step.label}
                    </text>
                    <line
                      x1={step.apToSta ? apX : staX}
                      x2={step.apToSta ? staArrowX : apArrowX}
                      y1={step.y}
                      y2={step.y}
                      class="wifi-link"
                      marker-end={`url(#${arrow})`}
                    />
                    <text x={w / 2} y={step.y + 28} class="wifi-small">
                      {t(step.detail)}
                    </text>
                  </g>
                ))}
                <rect x="20" y="488" width={w - 40} height={mobile ? 58 : 30} class="wifi-band" />
                {mobile ? (
                  <>
                    <text x={w / 2} y="511" class="wifi-small">
                      {t("PMK + 双方地址 + 两端 Nonce")}
                    </text>
                    <text x={w / 2} y="534" class="wifi-code">
                      {t("→ 本地派生 PTK")}
                    </text>
                  </>
                ) : (
                  <text x={w / 2} y="509" class="wifi-small">
                    {t("PMK + 双方地址 + ANonce + SNonce → 本地派生 PTK")}
                  </text>
                )}
              </>
            )}

            {variant === "discovery" && (
              <>
                <text x={w / 2} y="108" class="wifi-small">
                  {t("被动扫描 / Passive")}
                </text>
                <line x1="20" x2={w - 20} y1="188" y2="188" class="wifi-rule" />
                <text x={w / 2} y="215" class="wifi-small">
                  {t("主动扫描 / Active")}
                </text>
                {DISCOVERY_MESSAGES.map((msg) => (
                  <g>
                    <line
                      x1={msg.apToSta ? apX : staX}
                      x2={msg.apToSta ? staArrowX : apArrowX}
                      y1={msg.y}
                      y2={msg.y}
                      class:list={["wifi-link", { "wifi-link-secondary": msg.secondary }]}
                      marker-end={`url(#${arrow})`}
                    />
                    <text x={w / 2} y={msg.y - (msg.apToSta ? 10 : 11)} class="wifi-code">
                      {msg.code}
                    </text>
                  </g>
                ))}
                <rect x="20" y="356" width={w - 40} height="38" class="wifi-band" />
                <text x={w / 2} y="380" class="wifi-small">
                  {t("发现信息：SSID · BSSID · 信道 · RSN")}
                </text>
              </>
            )}

            {variant === "layers" &&
              (mobile ? (
                <>
                  <path d="M 62 94 H 32 V 484 H 62" class="wifi-bracket" />
                  <text x="20" y="294" transform="rotate(-90 20 294)" class="wifi-code wifi-tls">
                    {t("TLS / HTTPS：终端 ↔ 服务端")}
                  </text>
                  <path d="M 260 126 H 290 V 302 H 260" class="wifi-bracket wifi-bracket-radio" />
                  <text x="309" y="215" transform="rotate(90 309 215)" class="wifi-small wifi-radio">
                    {t("WiFi 链路保护")}
                  </text>
                  {LAYER_NODES.map((node, i) => (
                    <g>
                      <rect x="72" y={node.mobileY} width="176" height="76" class="wifi-node" />
                      <text x="160" y={node.mobileY + 31} class="wifi-label">
                        {t(node.label)}
                      </text>
                      <text x="160" y={node.mobileY + 56} class="wifi-small">
                        {t(node.mobileDetail)}
                      </text>
                      {i < LAYER_NODES.length - 1 && (
                        <>
                          <line
                            x1="160"
                            x2="160"
                            y1={node.mobileY + 76}
                            y2={node.mobileY + 180}
                            class="wifi-link"
                            marker-end={`url(#${arrow})`}
                          />
                          <text x="210" y={node.mobileY + 135} class="wifi-small">
                            {t(i === 0 ? "空口" : "上联")}
                          </text>
                        </>
                      )}
                    </g>
                  ))}
                  <text x="160" y="579" class="wifi-small">
                    {t("两层保护具有不同的终止位置")}
                  </text>
                </>
              ) : (
                <>
                  <path d="M 106 117 V 68 H 614 V 117" class="wifi-bracket" />
                  <text x="360" y="46" class="wifi-code wifi-tls">
                    {t("TLS / HTTPS：应用终端 ↔ 远端服务端")}
                  </text>
                  {LAYER_NODES.map((node, i) => (
                    <g>
                      <rect x={node.desktopX} y="143" width="160" height="80" class="wifi-node" />
                      <text x={node.desktopX + 80} y="176" class="wifi-label">
                        {t(node.label)}
                      </text>
                      <text x={node.desktopX + 80} y="201" class="wifi-small">
                        {t(node.desktopDetail)}
                      </text>
                      {i < LAYER_NODES.length - 1 && (
                        <>
                          <line
                            x1={node.desktopX + 160}
                            x2={node.desktopX + 246}
                            y1="183"
                            y2="183"
                            class="wifi-link"
                            marker-end={`url(#${arrow})`}
                          />
                          <text x={node.desktopX + 205} y="164" class="wifi-small">
                            {t(i === 0 ? "空口" : "上联")}
                          </text>
                        </>
                      )}
                    </g>
                  ))}
                  <path d="M 106 246 V 283 H 360 V 246" class="wifi-bracket wifi-bracket-radio" />
                  <text x="233" y="309" class="wifi-code wifi-radio">
                    {t("WPA2 / WPA3：STA ↔ AP")}
                  </text>
                  <text x="360" y="350" class="wifi-small">
                    {t("抓到无线帧 → 链路解密条件 → 应用层加密条件 → 可见数据")}
                  </text>
                </>
              ))}

            {variant === "frames" && (
              <>
                <text x={w / 2} y="36" class="wifi-small">
                  {t("捕获记录 / Capture record")}
                </text>
                {FRAME_SEGMENTS.map((seg, i) => {
                  const box = mobile ? seg.mobile : seg.desktop;
                  const cx = box.x + box.width / 2;
                  return (
                    <g>
                      <rect
                        x={box.x}
                        y={box.y}
                        width={box.width}
                        height={mobile ? 70 : 100}
                        class:list={["wifi-frame-block", `wifi-frame-${i}`]}
                      />
                      <text x={cx} y={box.y + (mobile ? 29 : 43)} class="wifi-code">
                        {seg.label}
                      </text>
                      <text x={cx} y={box.y + (mobile ? 52 : 70)} class="wifi-small">
                        {t(box.detail)}
                      </text>
                    </g>
                  );
                })}
                <text x={w / 2} y={mobile ? 353 : 218} class="wifi-muted">
                  {t("Radiotap 不属于空口发出的 MAC 帧")}
                </text>
                <text x={w / 2} y={mobile ? 378 : 248} class="wifi-small">
                  {t("* FCS 是否保留取决于网卡与驱动")}
                </text>
              </>
            )}
          </svg>
        );
      })
    )
  }
  <figcaption>
    <span class="wifi-caption-number">{t("图")} {number}.</span>
    {" "}
    {note}
  </figcaption>
</figure>
