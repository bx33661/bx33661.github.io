---
import { localeFromPath } from "@/i18n";
import { ui } from "@/i18n/ui";
const locale = localeFromPath(Astro.url.pathname);
const t = ui(locale);
import { formatSiteDate } from "@/utils/date";
import { getArticleDates } from "@/utils/article-discovery";
import { articleTransitionName } from "@/utils/reading-motion";

type Props = {
  href: string;
  title: string;
  description: string;
  date: Date;
  updatedDate?: Date | null;
  tags?: { label: string; href: string }[];
  variant?: "default" | "blog";
  category?: string;
  heading?: "h2" | "h3";
  interactive?: boolean;
};

const {
  href,
  title,
  description,
  date,
  updatedDate,
  tags = [],
  variant = "default",
  category,
  heading: Heading = "h2",
  interactive = false,
} = Astro.props;
const dates = getArticleDates(date, updatedDate);
const formatDate = (value: Date) => formatSiteDate(value, locale);
---

<li class:list={["entry-row", { "entry-row--blog": variant === "blog" }]} data-category={category}>
  {
    variant === "blog" ? (
      <div class="entry-dates">
        <span class="entry-date-label">{dates.updated ? t.updated : t.published}</span>
        <time datetime={dates.latest.toISOString()}>{formatDate(dates.latest)}</time>
        {dates.updated && (
          <span class="entry-original-date">
            {t.published} <time datetime={dates.published.toISOString()}>{formatDate(dates.published)}</time>
          </span>
        )}
      </div>
    ) : (
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
    )
  }
  <div class="entry-content">
    <div class="entry-heading">
      <Heading
        ><a
          href={href}
          data-article-title={variant === "blog" ? "" : undefined}
          transition:name={variant === "blog" ? articleTransitionName(href) : undefined}
          transition:animate={variant === "blog" ? "initial" : undefined}>{title}</a
        ></Heading
      >
      {category && <span class="entry-category">{category}</span>}
    </div>
    <p>{description}</p>
    {
      (interactive || tags.length > 0) && (
        <div class="entry-footer-meta">
          {interactive && (
            <span class="entry-interactive-pill">
              <span class="entry-interactive-dot" aria-hidden="true" />
              {t.interactive}
            </span>
          )}
          {tags.length > 0 && (
            <ul class="entry-tags" aria-label={t.topics}>
              {tags.map((tag) => (
                <li>
                  <a href={tag.href}>{tag.label}</a>
                </li>
              ))}
            </ul>
          )}
        </div>
      )
    }
  </div>
  <span class="entry-arrow" aria-hidden="true">↗</span>
</li>

<style>
  .entry-row {
    --entry-col-w: 6.7rem;
    --entry-gap: 0.8rem;
    --entry-py: 1.15rem;
    --entry-px: 0.15rem;
    --entry-border: color-mix(in srgb, var(--border) 28%, transparent);
    --entry-heading-size: 1rem;
    --entry-heading-lh: 1.55;
    --entry-heading-ls: normal;
    --entry-desc-color: color-mix(in srgb, var(--foreground) 62%, transparent);
    --entry-desc-size: 0.84rem;
    --entry-desc-lh: 1.65;
    --entry-gap-sm: 0.35rem 0.55rem;
    --entry-py-sm: 1rem;
    --entry-heading-size-sm: 1rem;
    display: grid;
    grid-template-columns: var(--entry-col-w) minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--entry-gap);
    padding: var(--entry-py) var(--entry-px);
    border-bottom: 1px solid var(--entry-border);
  }
  .entry-row:first-child {
    border-top: 1px solid var(--entry-border);
  }
  .entry-row[hidden] {
    display: none;
  }
  time {
    padding-top: 0.23rem;
    color: color-mix(in srgb, var(--foreground) 48%, transparent);
    font-family: var(--font-cartograph), ui-monospace, monospace;
    font-size: 0.73rem;
    white-space: nowrap;
  }
  .entry-content {
    min-width: 0;
  }
  .entry-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  :is(h2, h3) {
    margin: 0;
    font-size: var(--entry-heading-size);
    font-weight: 600;
    line-height: var(--entry-heading-lh);
    letter-spacing: var(--entry-heading-ls);
  }
  a {
    color: var(--foreground);
    text-decoration: none;
  }
  a:hover,
  a:focus-visible {
    color: var(--accent);
  }
  p {
    margin: 0.35rem 0 0;
    color: var(--entry-desc-color);
    font-size: var(--entry-desc-size);
    line-height: var(--entry-desc-lh);
  }
  .entry-category {
    flex: none;
    color: color-mix(in srgb, var(--foreground) 48%, transparent);
    font-size: 0.72rem;
    white-space: nowrap;
  }
  .entry-arrow {
    padding-top: 0.15rem;
    color: var(--accent);
    font-size: 0.85rem;
  }
  :global(html[data-theme="dark"]) time,
  :global(html[data-theme="dark"]) .entry-category {
    color: color-mix(in srgb, var(--foreground) 68%, transparent);
  }

  .entry-row--blog {
    --entry-col-w: 7rem;
    --entry-gap: 1.2rem;
    --entry-py: 1.6rem;
    --entry-px: 0;
    --entry-border: color-mix(in srgb, var(--foreground) 15%, var(--background));
    --entry-heading-size: 1.13rem;
    --entry-heading-lh: 1.65;
    --entry-heading-ls: -0.02em;
    --entry-desc-color: color-mix(in srgb, var(--foreground) 72%, var(--background));
    --entry-desc-size: 0.9rem;
    --entry-desc-lh: 1.85;
    --entry-gap-sm: 0.65rem;
    --entry-py-sm: 1.35rem;
    --entry-heading-size-sm: 1.05rem;
  }
  .entry-dates {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    color: color-mix(in srgb, var(--foreground) 72%, var(--background));
  }
  .entry-date-label {
    font-size: 0.68rem;
  }
  .entry-row--blog time {
    padding: 0;
    color: inherit;
    font-variant-numeric: tabular-nums;
  }
  .entry-original-date {
    font-size: 0.65rem;
    line-height: 1.6;
  }
  .entry-original-date time {
    font-size: inherit;
  }
  .entry-footer-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.55rem;
    margin-top: 0.75rem;
  }
  .entry-interactive-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.18rem 0.52rem;
    border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    color: var(--accent);
    font-family: var(--font-cartograph), monospace;
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .entry-interactive-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
  }
  .entry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .entry-tags a {
    display: block;
    padding: 0.18rem 0.5rem;
    border: 1px solid var(--border-subtle);
    border-radius: 0.35rem;
    background: color-mix(in srgb, var(--surface) 60%, transparent);
    color: var(--entry-desc-color);
    font-size: 0.7rem;
    transition:
      border-color 0.15s ease,
      color 0.15s ease,
      background-color 0.15s ease;
  }
  .entry-tags a:hover,
  .entry-tags a:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--accent) 6%, var(--surface));
    color: var(--accent);
  }
  @media (min-width: 768px) {
    .entry-row--blog {
      transition: background-color 0.18s ease;
    }
    .entry-row--blog:hover {
      margin-inline: -0.75rem;
      padding-inline: 0.75rem;
      border-radius: 0.65rem;
      background: color-mix(in srgb, var(--surface) 60%, transparent);
    }
  }
  @media (max-width: 640px) {
    .entry-row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--entry-gap-sm);
      padding: var(--entry-py-sm) 0;
    }
    time,
    .entry-dates {
      grid-column: 1 / -1;
      padding: 0;
    }
    .entry-heading {
      display: block;
    }
    .entry-category {
      display: inline-block;
      margin-top: 0.3rem;
    }
    .entry-dates {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.4rem 0.6rem;
    }
    :is(h2, h3) {
      font-size: var(--entry-heading-size-sm);
    }
  }
</style>
